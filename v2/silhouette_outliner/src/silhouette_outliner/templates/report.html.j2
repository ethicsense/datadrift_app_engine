  /* ---- Price × age heatmap (element-scoped) ---- */
  function initHeatmapWrap(wrap){
    if (!wrap) return;
    var payloadEl = wrap.querySelector('.heat-payload');
    var stageEl = wrap.querySelector('.heat-stage');
    var gridScene = wrap.querySelector('.heat-grid-scene');
    var grid = wrap.querySelector('.heat-grid');
    var mergeTrackEl = wrap.querySelector('.heat-merge-track');
    var detailEl = wrap.querySelector('.heat-chart-panel');
    var barsEl = wrap.querySelector('.heat-bars');
    var titleEl = wrap.querySelector('.heat-detail-title');
    var backBtn = wrap.querySelector('.heat-back-btn');
    if (!payloadEl || !stageEl || !grid || !mergeTrackEl || !detailEl || !barsEl || !titleEl) return;

    var motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var drillTimer = null;

    var genders;
    try { genders = JSON.parse(payloadEl.textContent || '[]'); } catch (e) { return; }
    var byKey = {};
    genders.forEach(function(g){ byKey[g.key] = g; });
    var orderedKeys = genders.map(function(g){ return g.key; });

    var currentGender = wrap.getAttribute('data-default-gender') || 'all';
    var drillMode = 'row';
    var drillIndex = 0;
    var barMode = 'single';
    var heatView = 'grid';

    function isBarsView(){
      return heatView === 'bars';
    }

    function setHeatView(view){
      heatView = view === 'bars' ? 'bars' : (view === 'transitioning' ? 'transitioning' : 'grid');
      wrap.setAttribute('data-heat-view', heatView);
      detailEl.setAttribute('aria-hidden', heatView === 'bars' ? 'false' : 'true');
    }

    var trackGeom = null;
    var floorLayout = null;
    var THIN = 7;

    function clearDrillAnim(){
      if (drillTimer) { clearTimeout(drillTimer); drillTimer = null; }
      grid.removeAttribute('data-axis');
      grid.classList.remove('is-gathering','is-handoff');
      grid.querySelectorAll('.is-focus').forEach(function(el){
        el.classList.remove('is-focus');
      });
      grid.querySelectorAll('.heat-cell[style*="--gather"]').forEach(function(el){
        el.style.removeProperty('--gather-x');
        el.style.removeProperty('--gather-y');
      });
      mergeTrackEl.className = 'heat-merge-track';
      mergeTrackEl.innerHTML = '';
      mergeTrackEl.removeAttribute('style');
      mergeTrackEl.setAttribute('aria-hidden', 'true');
      trackGeom = null;
      floorLayout = null;
      stageEl.style.removeProperty('--bars-inset-l');
      stageEl.style.removeProperty('--bars-width');
    }

    function heatmapDataBounds(){
      var stageRect = stageEl.getBoundingClientRect();
      var headers = grid.querySelectorAll('.heat-col-h');
      if (headers.length) {
        var first = headers[0].getBoundingClientRect();
        var last = headers[headers.length - 1].getBoundingClientRect();
        return {
          left: first.left - stageRect.left,
          width: last.right - first.left,
          cx: (first.left + last.right) / 2 - stageRect.left,
        };
      }
      return null;
    }

    function applyBarsLayout(){
      var layout = floorLayout;
      if (!layout) {
        var data = heatmapDataBounds();
        if (data) layout = { left: data.left, width: data.width };
      }
      if (!layout) return;
      stageEl.style.setProperty('--bars-inset-l', layout.left + 'px');
      stageEl.style.setProperty('--bars-width', layout.width + 'px');
    }

    function captureFloorLayout(){
      var tr = mergeTrackEl.getBoundingClientRect();
      var sr = stageEl.getBoundingClientRect();
      if (tr.width < 8) return;
      floorLayout = {
        left: tr.left - sr.left,
        width: tr.width,
      };
      applyBarsLayout();
    }

    function cellBounds(cells){
      var bounds = { l: Infinity, r: -Infinity, t: Infinity, b: -Infinity };
      cells.forEach(function(cell){
        var r = cell.getBoundingClientRect();
        bounds.l = Math.min(bounds.l, r.left);
        bounds.r = Math.max(bounds.r, r.right);
        bounds.t = Math.min(bounds.t, r.top);
        bounds.b = Math.max(bounds.b, r.bottom);
      });
      return bounds;
    }

    function markFocus(mode, index){
      grid.querySelectorAll('.is-focus').forEach(function(el){ el.classList.remove('is-focus'); });
      if (mode === 'row') {
        grid.querySelectorAll('.heat-cell[data-row="' + index + '"],.heat-row-h[data-row="' + index + '"]').forEach(function(el){
          el.classList.add('is-focus');
        });
      } else {
        grid.querySelectorAll('.heat-cell[data-col="' + index + '"],.heat-col-h[data-col="' + index + '"]').forEach(function(el){
          el.classList.add('is-focus');
        });
      }
    }

    function focusCells(mode, index){
      var sel = mode === 'row'
        ? '.heat-cell[data-row="' + index + '"]'
        : '.heat-cell[data-col="' + index + '"]';
      return Array.prototype.slice.call(grid.querySelectorAll(sel));
    }

    function applyGatherVectors(mode, index){
      // Pull non-focused cells toward the focused axis line (visually they "merge into" the axis as they fade).
      var focusedCells = focusCells(mode, index);
      if (!focusedCells.length) return;
      var stageRect = stageEl.getBoundingClientRect();
      var bounds = cellBounds(focusedCells);
      var axisY = (bounds.t + bounds.b) / 2 - stageRect.top;
      var axisX = (bounds.l + bounds.r) / 2 - stageRect.left;
      grid.querySelectorAll('.heat-cell').forEach(function(el){
        if (el.classList.contains('is-focus')) return;
        var r = el.getBoundingClientRect();
        var cy = r.top + r.height / 2 - stageRect.top;
        var cx = r.left + r.width / 2 - stageRect.left;
        if (mode === 'row') {
          el.style.setProperty('--gather-y', (axisY - cy) + 'px');
        } else {
          el.style.setProperty('--gather-x', (axisX - cx) + 'px');
        }
      });
    }

    function buildMergeTrack(mode, index){
      var cells = focusCells(mode, index);
      var stageRect = stageEl.getBoundingClientRect();
      var bounds = cellBounds(cells);
      var trackLeft = bounds.l - stageRect.left;
      var trackTop = bounds.t - stageRect.top;
      var trackW = Math.max(bounds.r - bounds.l, 60);
      var trackH = Math.max(bounds.b - bounds.t, 28);

      mergeTrackEl.className = 'heat-merge-track heat-merge-track--' + mode;
      mergeTrackEl.innerHTML = '';
      cells.forEach(function(cell){
        var seg = document.createElement('div');
        seg.className = 'heat-merge-track__seg';
        var cs = window.getComputedStyle(cell);
        seg.style.background = cs.backgroundColor;
        if (cell.classList.contains('dim')) {
          seg.style.color = cs.color;
        }
        mergeTrackEl.appendChild(seg);
      });
      mergeTrackEl.style.left = trackLeft + 'px';
      mergeTrackEl.style.top = trackTop + 'px';
      mergeTrackEl.style.width = trackW + 'px';
      mergeTrackEl.style.height = trackH + 'px';
      mergeTrackEl.style.transform = '';
      mergeTrackEl.setAttribute('aria-hidden', 'false');

      trackGeom = {
        mode: mode,
        left: trackLeft, top: trackTop,
        w: trackW, h: trackH,
        cx: trackLeft + trackW / 2,
        cy: trackTop + trackH / 2,
      };
    }

    function collapseToLine(){
      if (!trackGeom) return;
      if (trackGeom.mode === 'row') {
        // shrink height to THIN, keep horizontal extent
        mergeTrackEl.style.top = (trackGeom.cy - THIN / 2) + 'px';
        mergeTrackEl.style.height = THIN + 'px';
      } else {
        // shrink width to THIN, keep vertical extent
        mergeTrackEl.style.left = (trackGeom.cx - THIN / 2) + 'px';
        mergeTrackEl.style.width = THIN + 'px';
      }
    }

    function layAndDropToFloor(){
      if (!trackGeom) return;
      var stageRect = stageEl.getBoundingClientRect();
      var data = heatmapDataBounds();
      if (!data) return;
      var bottomGap = 12;
      var targetCy = stageRect.height - bottomGap - THIN / 2;
      var targetW = data.width;
      var targetCx = data.cx;

      if (trackGeom.mode === 'col') {
        var origLen = trackGeom.h;
        var sx = targetW / origLen;
        var tx = targetCx - trackGeom.cx;
        var ty = targetCy - trackGeom.cy;
        mergeTrackEl.style.transformOrigin = 'center center';
        // -90deg: top row (~첫 가격대) → left, bottom → right (bar order와 동일)
        mergeTrackEl.style.transform =
          'translate(' + tx + 'px,' + ty + 'px) scaleX(' + sx + ') rotate(-90deg)';
      } else {
        var sx2 = targetW / trackGeom.w;
        var tx2 = targetCx - trackGeom.cx;
        var ty2 = targetCy - trackGeom.cy;
        mergeTrackEl.style.transformOrigin = 'center center';
        mergeTrackEl.style.transform =
          'translate(' + tx2 + 'px,' + ty2 + 'px) scaleX(' + sx2 + ')';
      }
    }

    function after(ms, fn){
      drillTimer = setTimeout(fn, ms);
    }

    function runDrillAnimation(mode, index){
      clearDrillAnim();
      markFocus(mode, index);
      wrap.setAttribute('data-drill-mode', mode);
      wrap.setAttribute('data-drill-index', String(index));
      if (!motionOk) {
        setHeatView('bars');
        renderBars();
        return;
      }
      setHeatView('transitioning');

      // Phase 1: non-focused cells slide toward the focused axis and fade out.
      applyGatherVectors(mode, index);
      grid.setAttribute('data-axis', mode);
      grid.classList.add('is-gathering');

      after(380, function(){
        // Phase 2: build the track exactly over the focused cells (still visible),
        //         then hand off (focused cells fade).
        buildMergeTrack(mode, index);
        // force layout so subsequent style changes animate
        void mergeTrackEl.offsetWidth;
        mergeTrackEl.classList.add('is-visible');
        grid.classList.add('is-handoff');

        after(80, function(){
          // Phase 3: cross-axis compression → a thin colored line
          collapseToLine();

          after(440, function(){
            // Phase 4: col rotates -90° (lays down) and both row/col slide+scale to the card's bottom as a floor line.
            layAndDropToFloor();

            after(520, function(){
              requestAnimationFrame(function(){
                captureFloorLayout();
                setHeatView('bars');
                renderBars();
              });
            });
          });
        });
      });
    }

    function runBackAnimation(){
      if (!motionOk) {
        clearDrillAnim();
        setHeatView('grid');
        return;
      }
      if (drillTimer) { clearTimeout(drillTimer); drillTimer = null; }
      mergeTrackEl.classList.remove('is-visible');
      setHeatView('grid');
      // remove gather/handoff right away so cells slide+fade back together with grid scene
      grid.classList.remove('is-gathering','is-handoff');
      grid.removeAttribute('data-axis');
      grid.querySelectorAll('.is-focus').forEach(function(el){ el.classList.remove('is-focus'); });
      drillTimer = setTimeout(function(){ clearDrillAnim(); }, 480);
    }

    function genderData(key){
      return byKey[key || currentGender] || null;
    }

    function rowFor(g, idx){
      if (!g || !g.rows || !g.has_data) return null;
      return g.rows[idx] || null;
    }

    function valuesFor(g){
      if (!g || !g.has_data) return null;
      if (drillMode === 'row') {
        var row = rowFor(g, drillIndex);
        if (!row) return null;
        return row.cells.map(function(c){ return c.count || 0; });
      }
      return g.rows.map(function(row){
        var cell = row.cells[drillIndex] || {};
        return cell.count || 0;
      });
    }

    function labelsForCurrent(){
      var g = genderData();
      if (!g) return [];
      if (drillMode === 'row') {
        var row = rowFor(g, drillIndex);
        return row ? row.cells.map(function(c){ return c.age_label; }) : [];
      }
      return g.rows.map(function(row){ return row.price_label; });
    }

    function detailTitle(){
      var g = genderData();
      if (!g) return '';
      var sufx = barMode === 'compare' ? ' — 성별 비교' : ' · ' + g.label;
      if (drillMode === 'row') {
        var row = rowFor(g, drillIndex);
        return (row ? row.price_label : '') + ' 가격대 — 연령별 포함 수' + sufx;
      }
      var ageLabel = g.age_headers[drillIndex] || '';
      return ageLabel + ' — 가격대별 포함 수' + sufx;
    }

    function renderGrid(){
      var g = genderData();
      if (!g || !g.has_data) return;
      var cells = grid.querySelectorAll('.heat-cell');
      var rowLabels = grid.querySelectorAll('.heat-row-h');
      var idx = 0;
      g.rows.forEach(function(row, r){
        if (rowLabels[r]) rowLabels[r].textContent = row.price_label;
        row.cells.forEach(function(cell, c){
          var el = cells[idx++];
          if (!el) return;
          el.classList.toggle('empty', cell.count === 0);
          el.classList.toggle('dim', cell.count > 0 && cell.alpha < 0.42);
          el.style.setProperty('--a', cell.count ? String(cell.alpha) : '0');
          el.style.setProperty('--density', cell.count ? String(cell.density != null ? cell.density : cell.alpha) : '0');
          el.textContent = cell.count ? String(cell.count) : '';
          el.title = row.price_label + ' · ' + cell.age_label + ' · ' + cell.count + '개';
          el.setAttribute('data-row', String(r));
          el.setAttribute('data-col', String(c));
        });
      });
    }

    function buildBarsMarkup(){
      var labels = labelsForCurrent();
      if (!labels.length) return '';
      var seriesKeys = barMode === 'compare' ? orderedKeys : [currentGender];
      var seriesData = seriesKeys
        .map(function(k){ return { key: k, label: byKey[k] ? byKey[k].label : k, values: valuesFor(byKey[k]) }; })
        .filter(function(s){ return s.values; });
      if (!seriesData.length) return '';
      var maxV = 1;
      seriesData.forEach(function(s){
        s.values.forEach(function(v){ if (v > maxV) maxV = v; });
      });
      return labels.map(function(lbl, i){
        var stack = seriesData.map(function(s){
          var v = s.values[i] || 0;
          var pct = Math.max(2, Math.round(v / maxV * 100));
          return '<div class="fill" data-gender="' + s.key + '" data-final-height="' + pct + '" title="' + escapeHtml(s.label) + ' · ' + v + '개" style="height:2px"><span class="val">' + v + '</span></div>';
        }).join('');
        return '<div class="heat-bar"><div class="stack">' + stack + '</div><span class="lbl">' + escapeHtml(lbl) + '</span></div>';
      }).join('');
    }

    function animateBars(){
      var fills = barsEl.querySelectorAll('.fill');
      fills.forEach(function(f){
        f.classList.remove('is-shown');
        f.style.height = '2px';
      });
      void barsEl.offsetWidth;
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){
          fills.forEach(function(f){
            f.style.height = (f.getAttribute('data-final-height') || '0') + '%';
          });
          setTimeout(function(){ fills.forEach(function(f){ f.classList.add('is-shown'); }); }, 280);
        });
      });
    }

    function renderBars(){
      if (!isBarsView()) return;
      var g = genderData();
      if (!g || !g.has_data) {
        barsEl.innerHTML = '';
        titleEl.textContent = '데이터가 없어 분포를 표시할 수 없습니다';
        return;
      }
      titleEl.textContent = detailTitle();
      applyBarsLayout();
      barsEl.innerHTML = buildBarsMarkup();
      animateBars();
    }

    function updateSelection(mode, index){
      grid.querySelectorAll('.heat-row-h').forEach(function(r, i){
        r.classList.toggle('is-selected', mode === 'row' && i === index);
      });
      grid.querySelectorAll('.heat-col-h').forEach(function(c, i){
        c.classList.toggle('is-selected', mode === 'col' && i === index);
      });
    }

    function drillTo(mode, index){
      drillMode = mode;
      drillIndex = index;
      updateSelection(mode, index);
      if (heatView === 'bars') {
        markFocus(mode, index);
        renderBars();
        return;
      }
      runDrillAnimation(mode, index);
    }

    function pickDefaultRow(){
      var g = genderData();
      if (!g || !g.rows || !g.rows.length) return;
      var best = 0;
      var bestTotal = -1;
      g.rows.forEach(function(row, i){
        if (row.row_total > bestTotal) { bestTotal = row.row_total; best = i; }
      });
      drillMode = 'row';
      drillIndex = best;
      grid.querySelectorAll('.heat-row-h').forEach(function(el, i){
        el.classList.toggle('is-selected', i === best);
      });
      grid.querySelectorAll('.heat-col-h').forEach(function(el){ el.classList.remove('is-selected'); });
    }

    var genderThemeClasses = ['heat-gender-all', 'heat-gender-male', 'heat-gender-female'];

    function setGender(key){
      if (!byKey[key] || !byKey[key].has_data) return;
      currentGender = key;
      wrap.setAttribute('data-active-gender', key);
      genderThemeClasses.forEach(function(cls){ wrap.classList.remove(cls); });
      wrap.classList.add('heat-gender-' + key);
      wrap.querySelectorAll('.heat-gender-btn').forEach(function(btn){
        btn.setAttribute('aria-pressed', btn.getAttribute('data-gender') === key ? 'true' : 'false');
      });
      renderGrid();
      if (isBarsView()) renderBars();
    }

    function setBarMode(mode){
      if (mode !== 'single' && mode !== 'compare') return;
      barMode = mode;
      wrap.setAttribute('data-bar-mode', mode);
      wrap.querySelectorAll('.heat-bar-mode button').forEach(function(btn){
        btn.setAttribute('aria-pressed', btn.getAttribute('data-mode') === mode ? 'true' : 'false');
      });
      renderBars();
    }

    if (backBtn) {
      backBtn.addEventListener('click', function(){
        runBackAnimation();
      });
    }

    wrap.querySelectorAll('.heat-gender-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        setGender(btn.getAttribute('data-gender'));
      });
    });

    wrap.querySelectorAll('.heat-bar-mode button').forEach(function(btn){
      btn.addEventListener('click', function(){
        setBarMode(btn.getAttribute('data-mode'));
      });
    });

    grid.querySelectorAll('.heat-row-h').forEach(function(el){
      function activate(){
        drillTo('row', parseInt(el.getAttribute('data-row'), 10) || 0);
      }
      el.addEventListener('click', activate);
      el.addEventListener('keydown', function(e){
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
      });
    });

    grid.querySelectorAll('.heat-col-h').forEach(function(el){
      function activate(){
        var col = parseInt(el.getAttribute('data-col'), 10) || 0;
        drillTo('col', col);
        document.dispatchEvent(new CustomEvent('silhouette:heatmap-age-col', { detail: { col: col } }));
      }
      el.addEventListener('click', activate);
      el.addEventListener('keydown', function(e){
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
      });
    });

    pickDefaultRow();
  }
  document.querySelectorAll('.heat-wrap').forEach(initHeatmapWrap);

  /* ---- Customer signals: heatmap category toggle ---- */
  (function(){
    var btns = document.querySelectorAll('.cs-heatmap-cat-btn');
    if (!btns.length) return;
    var panels = document.querySelectorAll('.cs-heatmap-panel');
    function activate(code){
      btns.forEach(function(btn){
        var on = btn.getAttribute('data-cs-cat') === code;
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      panels.forEach(function(panel){
        var on = panel.getAttribute('data-cs-cat') === code;
        panel.classList.toggle('is-active', on);
        if (on) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });
    }
    btns.forEach(function(btn){
      btn.addEventListener('click', function(){
        if (btn.disabled) return;
        activate(btn.getAttribute('data-cs-cat'));
      });
    });
  })();

  /* ---- Insight / table linkage ---- */
  function focusFromPick(el){
    var chart = el.getAttribute('data-chart') || 'rl';
    var key = el.getAttribute('data-key');
    if (!key) return;
    setFocus(chart, key);
    var target = chart === 'scatter' ? document.getElementById('sec-dashboard') : document.getElementById('sec-cross');
    if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  document.querySelectorAll('.chart-pick').forEach(function(el){
    el.addEventListener('click', function(e){
      if (e.target.closest('a')) return;
      e.preventDefault();
      focusFromPick(el);
    });
    el.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        focusFromPick(el);
      }
    });
  });
})();

</script>
</body>
</html>
