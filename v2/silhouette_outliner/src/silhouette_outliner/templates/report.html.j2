        <p class="bc-note" style="margin:0 0 8px;font-size:11px">{{ card.subtitle }}</p>
        <div class="tw tw-scroll"><table>
          <thead><tr><th class="if-th-img" aria-label="이미지"></th><th>브랜드</th><th>상품</th><th>패턴</th><th class="num">스팬</th><th class="num">sust.</th><th>윈도우 순위</th></tr></thead>
          <tbody>{{ insight_table_rows(card.rows) }}</tbody>
        </table></div>
      </div>
      {% endif %}
      {% endfor %}
    </div>

    {% set me = analysis.cross_window.momentum_extrema %}
