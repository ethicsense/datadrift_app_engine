  /* ---- Rank line chart ---- */
  var rlWrap = document.querySelector('.rl-rel');
  if (rlWrap) {
    var rlSvg = rlWrap.querySelector('.rl-svg');
    var rlTip = document.getElementById('rltip');
    var rlPresets = {};
    try {
      var meta = document.getElementById('rl-chart-presets');
      if (meta) rlPresets = JSON.parse(meta.textContent);
    } catch (e) {}
    {% if analysis.cross_window.has_data %}
    var rlLabels = {{ analysis.cross_window.axis_labels | tojson }};
    {% else %}
    var rlLabels = {};
    {% endif %}
    var rlPresetId = rlWrap.getAttribute('data-default-preset') || 'top12';
    var rlSearch = '';
    var rlColorFilters = new Set();

    function rlCanvas(){
      return {
        padLeft: +rlSvg.dataset.padLeft,
        padTop: +rlSvg.dataset.padTop,
        innerW: +rlSvg.dataset.innerW,
        innerH: +rlSvg.dataset.innerH,
        maxLimit: +rlSvg.dataset.maxLimit,
        yPad: +rlSvg.dataset.yPad || 5
      };
    }
    function yForRank(rank, rankMin, rankMax, c){
      if (rankMax <= rankMin) return c.padTop;
      return c.padTop + (rank - rankMin) / (rankMax - rankMin) * c.innerH;
    }
    function presetKeys(){
      var p = rlPresets[rlPresetId];
      return p && p.keys ? p.keys : [];
    }
    function rlVisibleKeys(){
      var set;
      if (rlBinKeys) {
        set = new Set(rlBinKeys);
      } else if (rlEventKeys) {
        set = new Set(rlEventKeys);
      } else {
        set = new Set(presetKeys());
      }
      var q = norm(rlSearch);
      if (q) {
        set.forEach(function(k){
          var pl = rlSvg.querySelector('.pl[data-key="' + selKey(k) + '"]');
          if (!pl || !matchQuery(pl, q)) set.delete(k);
        });
      }
      return set;
    }
    function updateRlYAxis(c, rankMin, rankMax){
      var g = rlSvg.querySelector('.rl-y-axis');
      if (!g) return;
      var padL = c.padLeft;
      var top = c.padTop;
      var bottom = top + c.innerH;
      var right = padL + c.innerW;
      g.innerHTML = '';
      niceTicks(rankMin, rankMax).forEach(function(rank){
        var y = yForRank(rank, rankMin, rankMax, c);
        var line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('class', 'gridline');
        line.setAttribute('x1', padL);
        line.setAttribute('y1', y);
        line.setAttribute('x2', right);
        line.setAttribute('y2', y);
        g.appendChild(line);
        var text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        text.setAttribute('class', 'tick-label');
        text.setAttribute('x', padL - 6);
        text.setAttribute('y', y + 3);
        text.setAttribute('text-anchor', 'end');
        text.textContent = rank;
        g.appendChild(text);
      });
      var axisY = rlSvg.querySelector('.rl-axis-y');
      if (axisY) {
        axisY.setAttribute('y1', top);
        axisY.setAttribute('y2', bottom);
      }
    }
    function applyRl(){
      var c = rlCanvas();
      var visible = rlVisibleKeys();
      var rankMin = Infinity;
      var rankMax = -Infinity;
      var hasDistFilter = !!rlBinKeys || !!rlEventKeys;
      var pickHighlight = hasDistFilter && focusChart === 'rl' && focusKey;
      var ySource = (focusChart === 'rl' && focusKey && !pickHighlight) ? new Set([focusKey]) : visible;

      rlSvg.querySelectorAll('.pl, .nd').forEach(function(el){
        var key = el.getAttribute('data-key');
        var color = el.getAttribute('data-color');
        var inPreset = visible.has(key);
        var colorOk = !rlColorFilters.size || rlColorFilters.has(color);
        var show = inPreset && colorOk;
        if (pickHighlight) {
          el.classList.toggle('pick-on', key === focusKey);
          el.classList.remove('focus-on');
        } else if (focusChart === 'rl' && focusKey) {
          el.classList.toggle('focus-on', key === focusKey);
          el.classList.remove('pick-on');
        } else {
          el.classList.remove('focus-on', 'pick-on');
        }
        if (rlBinKeys || rlEventKeys) {
          el.classList.toggle('bin-on', show);
        } else {
          el.classList.remove('bin-on');
        }
        el.style.display = show ? '' : 'none';
        if (!show) return;
        if (ySource.has(key)) {
          var ranks = [];
          if (el.classList.contains('pl')) {
            try {
              JSON.parse(el.getAttribute('data-coords') || '[]').forEach(function(p){
                if (p.rank != null) ranks.push(p.rank);
              });
            } catch (err) {}
          } else {
            ranks.push(+el.getAttribute('data-rank'));
          }
          ranks.forEach(function(r){
            if (r < rankMin) rankMin = r;
            if (r > rankMax) rankMax = r;
          });
        }
      });

      if (!isFinite(rankMin)) { rankMin = 1; rankMax = c.maxLimit; }
      rankMin = Math.max(1, rankMin - c.yPad);
      rankMax = Math.min(c.maxLimit, rankMax + c.yPad);
      updateRlYAxis(c, rankMin, rankMax);

      rlSvg.querySelectorAll('.pl').forEach(function(pl){
        if (pl.style.display === 'none') return;
        try {
          var coords = JSON.parse(pl.getAttribute('data-coords') || '[]');
          pl.setAttribute('points', coords.map(function(p){
            return p.x + ',' + yForRank(p.rank, rankMin, rankMax, c);
          }).join(' '));
        } catch (err) {}
      });
      rlSvg.querySelectorAll('.nd').forEach(function(nd){
        if (nd.style.display === 'none') return;
        nd.setAttribute('cy', yForRank(+nd.getAttribute('data-rank'), rankMin, rankMax, c));
      });

      var hasColor = rlColorFilters.size > 0;
      rlWrap.classList.toggle('has-filter', hasColor && !hasDistFilter);
      rlWrap.classList.toggle('has-bin-filter', hasDistFilter);
      syncRlPickHighlightUi();
      var legend = rlWrap.querySelector('.cw-legend');
      if (legend) legend.classList.toggle('has-filter', hasColor && !hasDistFilter);
      ['up','down','flat'].forEach(function(g){
        rlWrap.classList.toggle('filter-' + g, rlColorFilters.has(g));
      });
    }
    rlWrap._apply = applyRl;

    rlWrap.querySelectorAll('.chart-preset-btn').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.preventDefault();
        clearRlDistFilter();
        rlPresetId = btn.getAttribute('data-preset');
        rlWrap.querySelectorAll('.chart-preset-btn').forEach(function(b){
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        applyRl();
      });
    });
    var rlSearchEl = rlWrap.querySelector('.chart-search');
    if (rlSearchEl) {
      rlSearchEl.addEventListener('input', function(){
        rlSearch = rlSearchEl.value;
        applyRl();
      });
    }
    var legend = rlWrap.querySelector('.cw-legend');
    if (legend) {
      legend.querySelectorAll('.leg-btn').forEach(function(btn){
        btn.addEventListener('click', function(e){
          e.preventDefault();
          var f = btn.getAttribute('data-filter');
          if (!f) return;
          if (rlColorFilters.has(f)) rlColorFilters.delete(f); else rlColorFilters.add(f);
          legend.querySelectorAll('.leg-btn').forEach(function(b){
            var ff = b.getAttribute('data-filter');
            b.setAttribute('aria-pressed', rlColorFilters.has(ff) ? 'true' : 'false');
          });
          applyRl();
        });
      });
      var resetBtn = legend.querySelector('.leg-reset');
      if (resetBtn) {
        resetBtn.addEventListener('click', function(e){
          e.preventDefault();
          rlColorFilters.clear();
          legend.querySelectorAll('.leg-btn').forEach(function(b){
            b.setAttribute('aria-pressed', 'false');
          });
          applyRl();
        });
      }
    }

    function rlTipShow(e){
      var t = e.target;
      if (!t.classList || (!t.classList.contains('pl') && !t.classList.contains('nd'))) return;
      if (t.style.display === 'none') return;
      var brand = escapeHtml(t.getAttribute('data-brand'));
      var product = escapeHtml(t.getAttribute('data-product'));
      var pattern = escapeHtml(t.getAttribute('data-pattern'));
      var span = parseFloat(t.getAttribute('data-span'));
      var spanText = isNaN(span) ? '-' : (span >= 0 ? '+' : '') + span.toFixed(2);
      var evCluster = t.getAttribute('data-event-cluster') || '';
      var evStrength = parseFloat(t.getAttribute('data-event-strength'));
      var evText = evCluster && evCluster !== 'none'
        ? ' <em>· event ' + escapeHtml(evCluster) + (isNaN(evStrength) ? '' : ' str ' + evStrength.toFixed(2)) + '</em>'
        : '';
      var extra = '';
      if (t.classList.contains('nd')) {
        var rk = escapeHtml(t.getAttribute('data-rank'));
        var wid = t.getAttribute('data-wid');
        extra = '<em>· ' + escapeHtml(rlLabels[wid] || wid || '') + ' #' + rk + '</em>';
      }
      rlTip.innerHTML = '<b>' + brand + '</b><br>' + product + '<br>pattern: ' + pattern + ' <em>· momentum_span ' + spanText + '</em>' + evText + extra + '<br><em style="color:#a5a5b6">클릭: 강조 · 재클릭: 상품 열기</em>';
      var rect = rlWrap.getBoundingClientRect();
      var cx = e.clientX - rect.left + 12;
      var cy = e.clientY - rect.top + 12;
      if (cx + rlTip.offsetWidth + 16 > rect.width) cx = e.clientX - rect.left - rlTip.offsetWidth - 12;
      rlTip.style.left = cx + 'px';
      rlTip.style.top = cy + 'px';
      rlTip.style.opacity = '1';
      rlTip.setAttribute('aria-hidden', 'false');
    }
    function rlTipHide(e){
      if (e.target.classList && (e.target.classList.contains('pl') || e.target.classList.contains('nd'))) {
        rlTip.style.opacity = '0';
        rlTip.setAttribute('aria-hidden', 'true');
      }
    }
    rlSvg.addEventListener('mousemove', rlTipShow);
    rlSvg.addEventListener('mouseout', rlTipHide);
    rlSvg.addEventListener('click', function(e){
      var t = e.target;
      if (!t.classList) return;
      if (!t.classList.contains('pl') && !t.classList.contains('nd')) return;
      var key = t.getAttribute('data-key');
      if (!key) return;
      if (focusChart === 'rl' && focusKey === key) {
        var url = t.getAttribute('data-url');
        if (url) window.open(url, '_blank', 'noopener');
      } else {
        setFocus('rl', key);
      }
    });
    applyRl();
  }

