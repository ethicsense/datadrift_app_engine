{% if analysis.cross_window.has_data %}
<section id="sec-cross">
  <div class="sec-h"><h2>기간 교차<br>모멘텀</h2><p>{{ analysis.cross_window.disclaimer }}</p></div>
  <p class="bc-note" style="margin-bottom:14px">동일 상품은 product_id(없으면 URL · 브랜드+상품명)로 묶었습니다. join {{ analysis.cross_window.join_size }}건. 이미지는 무신사 CDN을 직접 핫링크하므로 <b>오프라인에서는 보이지 않습니다.</b></p>

  <div class="cw-wrap">
    {% set chart = analysis.cross_window.momentum_chart %}
    {% set dist = analysis.cross_window.momentum_distribution %}
    {% set evdist = analysis.cross_window.event_distribution %}
    <div class="cw-grid-2">
      {% if chart.has_data %}
      <div class="cw-card rl-rel" data-default-preset="{{ chart.default_preset }}">
        <h3>순위 변동 (윈도우 간 라인)</h3>
        <div class="chart-toolbar">
          <div class="chart-presets" role="group" aria-label="표시 개수">
            {% for pid, preset in chart.presets.items() %}
            <button type="button" class="chart-preset-btn" data-preset="{{ pid }}" aria-pressed="{{ 'true' if preset.default else 'false' }}">{{ preset.label }}</button>
            {% endfor %}
          </div>
          <input type="search" class="chart-search" placeholder="브랜드·상품 검색" aria-label="라인 차트 검색" autocomplete="off">
          <button type="button" class="chart-focus-clear" hidden>선택 해제</button>
        </div>
        <script type="application/json" id="rl-chart-presets">{{ chart.presets | tojson }}</script>
        {% set c = chart.canvas %}
        <svg class="rl-svg" viewBox="0 0 {{ c.w }} {{ c.h }}" preserveAspectRatio="xMidYMid meet" aria-label="윈도우별 순위 변동"
          data-pad-left="{{ c.pad_left }}" data-pad-top="{{ c.pad_top }}" data-inner-w="{{ c.inner_w }}" data-inner-h="{{ c.inner_h }}" data-max-limit="{{ chart.max_limit }}" data-y-pad="{{ chart.y_pad }}">
          <g class="rl-y-axis">
          {% for yt in chart.y_ticks %}
          <line class="gridline" x1="{{ c.pad_left }}" y1="{{ yt.y }}" x2="{{ c.pad_left + c.inner_w }}" y2="{{ yt.y }}" />
          <text class="tick-label" x="{{ c.pad_left - 6 }}" y="{{ yt.y + 3 }}" text-anchor="end">{{ yt.rank }}</text>
          {% endfor %}
          </g>
          <line class="axis rl-axis-y" x1="{{ c.pad_left }}" y1="{{ c.pad_top }}" x2="{{ c.pad_left }}" y2="{{ c.pad_top + c.inner_h }}" />
          <line class="axis" x1="{{ c.pad_left }}" y1="{{ c.pad_top + c.inner_h }}" x2="{{ c.pad_left + c.inner_w }}" y2="{{ c.pad_top + c.inner_h }}" />
          {% for ax in chart.axis_windows %}
          <line class="col-line" x1="{{ ax.x }}" y1="{{ c.pad_top }}" x2="{{ ax.x }}" y2="{{ c.pad_top + c.inner_h }}" />
          <text class="axlbl" x="{{ ax.x }}" y="{{ c.pad_top + c.inner_h + 16 }}" text-anchor="middle">{{ ax.label }}</text>
          {% if ax.days %}<text class="axlbl-d" x="{{ ax.x }}" y="{{ c.pad_top + c.inner_h + 28 }}" text-anchor="middle">{{ ax.days }}일</text>{% endif %}
          {% endfor %}
          <text class="tick-label" x="{{ c.pad_left - 36 }}" y="{{ c.pad_top + 4 }}">순위</text>
          <g class="rl-lines">
          {% for line in (chart.all_lines | default(chart.lines)) if not line.highlight %}
          <polyline class="pl pl-{{ line.color }} dim" points="{{ line.polyline }}"
            data-key="{{ line.key }}" data-color="{{ line.color }}"
            data-coords='{{ line.observed_coords | tojson }}'
            data-brand="{{ line.brand }}" data-product="{{ line.product }}"
            data-url="{{ line.url }}" data-pattern="{{ line.pattern }}"
            data-span="{{ line.momentum_span if line.momentum_span is not none else '' }}"
            data-event-cluster="{{ line.event_cluster or '' }}"
            data-event-strength="{{ line.event_strength if line.event_strength is not none else '' }}"
            data-image="{{ line.image_url }}"></polyline>
          {% endfor %}
          {% for line in (chart.all_lines | default(chart.lines)) if line.highlight %}
          <polyline class="pl pl-{{ line.color }} hl" points="{{ line.polyline }}"
            data-key="{{ line.key }}" data-color="{{ line.color }}"
            data-coords='{{ line.observed_coords | tojson }}'
            data-brand="{{ line.brand }}" data-product="{{ line.product }}"
            data-url="{{ line.url }}" data-pattern="{{ line.pattern }}"
            data-span="{{ line.momentum_span if line.momentum_span is not none else '' }}"
            data-event-cluster="{{ line.event_cluster or '' }}"
            data-event-strength="{{ line.event_strength if line.event_strength is not none else '' }}"
            data-image="{{ line.image_url }}"></polyline>
          {% endfor %}
          </g>
          <g class="rl-nodes">
          {% for line in (chart.all_lines | default(chart.lines)) %}
            {% for pt in line.points if pt.observed %}
            <circle class="nd nd-{{ line.color }}" cx="{{ pt.x }}" cy="{{ pt.y }}" r="3.2"
              data-key="{{ line.key }}" data-color="{{ line.color }}" data-rank="{{ pt.rank }}" data-cx="{{ pt.x }}"
              data-brand="{{ line.brand }}" data-product="{{ line.product }}"
              data-url="{{ line.url }}" data-pattern="{{ line.pattern }}"
              data-wid="{{ pt.wid }}"
              data-span="{{ line.momentum_span if line.momentum_span is not none else '' }}"
              data-event-cluster="{{ line.event_cluster or '' }}"
              data-event-strength="{{ line.event_strength if line.event_strength is not none else '' }}"
              data-image="{{ line.image_url }}"></circle>
            {% endfor %}
          {% endfor %}
          </g>
        </svg>
        <div class="rl-tip" id="rltip" role="tooltip" aria-hidden="true"></div>
        {% set cc = chart.color_counts %}
        <div class="cw-legend" role="group" aria-label="라인 색상 필터">
          <button type="button" class="leg-btn" data-filter="up" aria-pressed="false" title="현재 펄스가 더 좋은 상품만 강조 (momentum_span > 0.1)">
            <span class="swatch sw-up"></span>현재 펄스↑ <b>{{ cc.up }}</b>
          </button>
          <button type="button" class="leg-btn" data-filter="down" aria-pressed="false" title="과거 누적이 더 좋은 상품만 강조 (momentum_span &lt; -0.1)">
            <span class="swatch sw-down"></span>과거 누적↑ <b>{{ cc.down }}</b>
          </button>
          <button type="button" class="leg-btn" data-filter="flat" aria-pressed="false" title="모멘텀이 거의 평탄한 상품만 강조 (|momentum_span| &lt; 0.1)">
            <span class="swatch sw-flat"></span>평탄 <b>{{ cc.flat }}</b>
          </button>
          <button type="button" class="leg-reset" aria-label="색상 필터 해제">색상 필터 해제</button>
          <span class="leg-spacer"></span>
          <span class="leg-hint">프리셋·검색·분포/이벤트 클릭 · 스팬 {{ chart.momentum_cohort_size }} · 이벤트 {{ chart.event_cohort_size|default(0) }} · join {{ chart.candidate_count }}</span>
        </div>
      </div>
      {% endif %}

      {% if dist.has_data or evdist.has_data %}
      <div class="cw-card mh-card" id="mh-dist">
        <h3>모멘텀 분포{% if dist.has_data %} <span class="mh-meta-sub">(스팬 {{ dist.total }})</span>{% endif %}</h3>
        {% if dist.has_data %}
        <div class="mh">
        {% for cell in dist.cells %}
          <div class="mh-row{% if not cell.count %} mh-row--off{% endif %}" role="button" tabindex="0"
            data-bin-index="{{ cell.index }}" data-keys='{{ cell.product_keys | tojson }}'
            aria-pressed="false"{% if not cell.count %} aria-disabled="true"{% endif %}
            title="{% if cell.count %}클릭: 차트 필터 + 아래 {{ cell.count }}건 목록{% else %}해당 구간 없음{% endif %}">
            <span class="mh-lbl">[{{ "%+.2f"|format(cell.lo) }}, {{ "%+.2f"|format(cell.hi) }}{% if loop.last %}]{% else %}){% endif %}</span>
            <span class="mh-tr"><span class="mh-fl {{ cell.side }}" style="width:{{ cell.pct }}%"></span></span>
            <span class="mh-val">{{ cell.count }}</span>
          </div>
        {% endfor %}
        </div>
        <div class="mh-meta">
          <span>상승 <b>{{ dist.pos_count }}</b></span>
          <span>중립 <b>{{ dist.mid_count }}</b></span>
          <span>하락 <b>{{ dist.neg_count }}</b></span>
          <span>스팬 <b>{{ dist.total }}</b></span>
          <button type="button" class="mh-reset" aria-label="필터 해제">필터 해제</button>
        </div>
        {% endif %}
        {% if evdist.has_data %}
        <div class="ev-section">
          <h4>이벤트 클러스터 <span class="mh-meta-sub">(join {{ evdist.join_size }} 중 {{ evdist.total }})</span></h4>
          <div class="ev-list">
          {% for cell in evdist.cells %}
            <div class="ev-row{% if not cell.count %} ev-row--off{% endif %}{% if cell.is_primary %} ev-row--primary{% endif %}" role="button" tabindex="0"
              data-event-cluster="{{ cell.id }}" data-keys='{{ cell.product_keys | tojson }}'
              aria-pressed="false"{% if not cell.count %} aria-disabled="true"{% endif %}
              title="{% if cell.count %}클릭: 차트 필터 + 아래 {{ cell.count }}건 목록{% else %}해당 없음{% endif %}">
              <span class="ev-lbl">{{ cell.label }}</span>
              <span class="ev-val">{{ cell.count }}</span>
            </div>
          {% endfor %}
          </div>
        </div>
        {% endif %}
        <p class="mh-hint">스팬 막대·이벤트 행 클릭 → 차트 필터 + 아래 상품 목록(재클릭 해제). 스팬은 rank_energy(현재)−rank_energy(과거)만 사용합니다.</p>
      </div>
      {% endif %}
    </div>

    {% if dist.has_data %}
    <div id="mh-panels" class="ev-panels" hidden>
      {% for cell in dist.cells if cell.count %}
      <div id="mh-panel-{{ cell.index }}" class="ev-panel cw-card" data-bin-index="{{ cell.index }}" hidden>
        <div class="ev-panel-h">
          <span class="ev-panel-title">{{ cell.label }}</span>
          <span class="ev-panel-count">전체 {{ cell.count }}건</span>
          <button type="button" class="ev-panel-close mh-panel-close" aria-label="구간 목록 닫기">닫기</button>
        </div>
        <p class="bc-note ev-panel-note">{{ cell.subtitle }}</p>
        {% if cell.picks %}
        <ul class="ev-picks" aria-label="{{ cell.label }} 미리보기">
        {% for pick in cell.picks %}
          <li class="in-row chart-pick" data-chart="rl" data-key="{{ pick.key }}" tabindex="0" role="button" title="차트에서 강조">
            <span class="thumb-wrap">
              {% if pick.image_url %}<img src="{{ pick.image_url }}" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt="">{% else %}{{ (pick.brand or pick.product or '·')[:1] }}{% endif %}
            </span>
            <div class="name">
              <span class="b">{{ pick.brand }}</span>
              <span class="p">{% if pick.url %}<a href="{{ pick.url }}" target="_blank" rel="noopener" onclick="event.stopPropagation()">{{ pick.product }}</a>{% else %}{{ pick.product }}{% endif %}</span>
              <span class="chain">
              {% for seg in pick.ranks_chain %}
                <span class="seg{% if not seg.observed %} miss{% endif %}">{{ seg.label }} {% if seg.observed %}#{{ seg.rank }}{% else %}–{% endif %}</span>
              {% endfor %}
              </span>
              <span class="meta">
                {% if pick.momentum_span is not none %}모멘텀 <b class="{% if pick.momentum_span >= 0 %}pos{% else %}neg{% endif %}">{{ "%+.2f"|format(pick.momentum_span) }}</b>{% endif %}
                · sustained <b>{{ "%.2f"|format(pick.sustained_rank_energy or 0) }}</b>
              </span>
            </div>
          </li>
        {% endfor %}
        </ul>
        {% endif %}
        <div class="tw tw-scroll"><table>
          <thead><tr><th class="if-th-img" aria-label="이미지"></th><th>브랜드</th><th>상품</th><th>패턴</th><th class="num">스팬</th><th class="num">sust.</th><th>윈도우 순위</th></tr></thead>
          <tbody>{{ insight_table_rows(cell.rows) }}</tbody>
        </table></div>
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if evdist.has_data %}
    <div id="ev-panels" class="ev-panels" hidden>
      {% for cell in evdist.cells if cell.count %}
      <div id="ev-panel-{{ cell.id }}" class="ev-panel cw-card" data-event-cluster="{{ cell.id }}" hidden>
        <div class="ev-panel-h">
          <span class="ev-panel-title">{{ cell.label }}</span>
          <span class="ev-panel-count">전체 {{ cell.count }}건</span>
          <button type="button" class="ev-panel-close" aria-label="이벤트 목록 닫기">닫기</button>
        </div>
        <p class="bc-note ev-panel-note">{{ cell.subtitle }}</p>
        {% if cell.picks %}
        <ul class="ev-picks" aria-label="{{ cell.label }} 미리보기">
        {% for pick in cell.picks %}
          <li class="in-row chart-pick" data-chart="rl" data-key="{{ pick.key }}" tabindex="0" role="button" title="차트에서 강조">
            <span class="thumb-wrap">
              {% if pick.image_url %}<img src="{{ pick.image_url }}" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt="">{% else %}{{ (pick.brand or pick.product or '·')[:1] }}{% endif %}
            </span>
            <div class="name">
              <span class="b">{{ pick.brand }}</span>
              <span class="p">{% if pick.url %}<a href="{{ pick.url }}" target="_blank" rel="noopener" onclick="event.stopPropagation()">{{ pick.product }}</a>{% else %}{{ pick.product }}{% endif %}</span>
              <span class="chain">
              {% for seg in pick.ranks_chain %}
                <span class="seg{% if not seg.observed %} miss{% endif %}">{{ seg.label }} {% if seg.observed %}#{{ seg.rank }}{% else %}–{% endif %}</span>
              {% endfor %}
              </span>
              <span class="meta">event strength <b>{{ "%.2f"|format(pick.event_strength or 0) }}</b></span>
            </div>
          </li>
        {% endfor %}
        </ul>
        {% endif %}
        <div class="tw tw-scroll"><table>
          <thead><tr><th class="if-th-img" aria-label="이미지"></th><th>브랜드</th><th>상품</th><th class="num">강도</th><th>윈도우 순위</th></tr></thead>
