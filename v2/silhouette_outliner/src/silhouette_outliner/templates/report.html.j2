              {% endfor %}
            </div>
          </div>
          <div class="heat-stage">
            <div class="heat-grid-scene">
              <div class="heat-grid" style="--age-cols:{{ hm.age_headers|length }}">
                <div></div>
                {% for h in hm.age_headers %}
                <div class="h heat-col-h" data-col="{{ loop.index0 }}" tabindex="0" role="button" title="열 클릭: 가격대별 분포">{{ h }}</div>
                {% endfor %}
                {% if active and active.rows %}
                {% for row in active.rows %}
                {% set row_idx = loop.index0 %}
                <div class="rl heat-row-h" data-row="{{ row_idx }}" tabindex="0" role="button" title="행 클릭: 연령별 분포">{{ row.price_label }}</div>
                {% for cell in row.cells %}
                {% set col_idx = loop.index0 %}
                  {% if cell.count == 0 %}
                    <div class="heat-cell empty" data-row="{{ row_idx }}" data-col="{{ col_idx }}" title="{{ row.price_label }} · {{ cell.age_label }} · 0개"></div>
                  {% else %}
                    <div class="heat-cell{% if cell.alpha < 0.42 %} dim{% endif %}" data-row="{{ row_idx }}" data-col="{{ col_idx }}" style="--a:{{ cell.alpha }};--density:{{ cell.density }}" title="{{ row.price_label }} · {{ cell.age_label }} · {{ cell.count }}개">{{ cell.count }}</div>
                  {% endif %}
                {% endfor %}
                {% endfor %}
                {% endif %}
              </div>
            </div>
            <div class="heat-merge-track" aria-hidden="true"></div>
            <div class="heat-chart-panel" aria-hidden="true">
              <div class="heat-detail-top">
                <button type="button" class="heat-back-btn" aria-label="히트맵으로 돌아가기">← 히트맵</button>
