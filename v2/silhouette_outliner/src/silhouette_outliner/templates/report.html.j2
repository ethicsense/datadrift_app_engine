{% if analysis.scatter.has_data %}
<section id="sec-dashboard">
  <div class="sec-h"><h2>순위 × 검증 신호</h2><p>"이 순위면 사용자 활동량은 보통 이만큼"이라는 추세선과의 갭이 진짜 outlier다{% if analysis.meta.multiple_windows %} · 아래 차트는 <b>{{ analysis.headline.primary_window_label }}</b> 패널 기준{% endif %}</p></div>
  <div class="scatter-wrap scatter-rel" data-default-preset="{{ analysis.scatter.default_preset }}">
    <div class="chart-toolbar">
      <div class="chart-presets" role="group" aria-label="순위 구간">
        {% for pid, preset in analysis.scatter.presets.items() %}
        <button type="button" class="chart-preset-btn sc-preset-btn" data-preset="{{ pid }}" aria-pressed="{{ 'true' if preset.default else 'false' }}">{{ preset.label }}</button>
        {% endfor %}
      </div>
      <input type="search" class="chart-search sc-chart-search" placeholder="브랜드·상품 검색" aria-label="산점도 검색" autocomplete="off">
      <button type="button" class="chart-focus-clear sc-focus-clear" hidden>선택 해제</button>
    </div>
    {% set c = analysis.scatter.canvas %}
    <svg class="scatter-svg" viewBox="0 0 {{ c.w }} {{ c.h }}" preserveAspectRatio="xMidYMid meet" aria-label="순위 대 검증 신호 산점도">
      <line class="axis" x1="{{ c.pad_left }}" y1="{{ c.pad_top + c.inner_h }}" x2="{{ c.pad_left + c.inner_w }}" y2="{{ c.pad_top + c.inner_h }}" />
      <line class="axis" x1="{{ c.pad_left }}" y1="{{ c.pad_top }}" x2="{{ c.pad_left }}" y2="{{ c.pad_top + c.inner_h }}" />
      {% for yt in analysis.scatter.y_ticks %}
      <line class="axis" x1="{{ c.pad_left - 3 }}" y1="{{ yt.y }}" x2="{{ c.pad_left }}" y2="{{ yt.y }}" />
      <text class="tick-label" x="{{ c.pad_left - 6 }}" y="{{ yt.y + 3 }}" text-anchor="end">{{ yt.label }}</text>
      {% endfor %}
      <line class="trend" x1="{{ analysis.scatter.trend.x1 }}" y1="{{ analysis.scatter.trend.y1 }}" x2="{{ analysis.scatter.trend.x2 }}" y2="{{ analysis.scatter.trend.y2 }}" />
      <text class="tick-label" x="{{ c.pad_left }}" y="{{ c.pad_top + c.inner_h + 18 }}">1위</text>
      <text class="tick-label" x="{{ c.pad_left + c.inner_w }}" y="{{ c.pad_top + c.inner_h + 18 }}" text-anchor="end">{{ analysis.headline.item_count }}위</text>
      <text class="tick-label" x="{{ c.pad_left - 6 }}" y="{{ c.pad_top + 12 }}" text-anchor="end">검증↑</text>
      {% for p in analysis.scatter.points %}
      <circle class="pt pt-{{ p.side }}" cx="{{ p.x }}" cy="{{ p.y }}" r="{{ p.r }}"
        data-key="{{ p.key }}" data-rank-band="{{ p.rank_band }}" data-outlier="{{ '1' if p.is_outlier else '0' }}"
        data-brand="{{ p.brand }}" data-product="{{ p.product }}"
        data-rank="{{ p.rank }}" data-rc="{{ p.review_count }}" data-bn="{{ p.buyers_now }}"
        data-res="{{ p.residual }}" data-side="{{ p.side }}"
        data-url="{{ p.url }}"></circle>
      {% endfor %}
      {% for lab in analysis.scatter.labels %}
      <text class="ol ol-{{ lab.kind }}" x="{{ lab.x }}" y="{{ lab.y }}" text-anchor="middle" data-key="{{ lab.key }}">#{{ lab.rank }} {{ lab.brand }}</text>
      {% endfor %}
    </svg>
    <div class="scatter-tip" id="sctip" role="tooltip" aria-hidden="true"></div>
    <div class="scatter-legend">
      <span><span class="dot dot-above"></span>추세선 위 = 검증된 강자 <b>{{ analysis.scatter.summary.above }}</b>개</span>
      <span><span class="dot dot-below"></span>추세선 아래 = 푸시/신상 의심 <b>{{ analysis.scatter.summary.below }}</b>개</span>
      <span>Y축: 검증 점수 = 0.5×log리뷰 + 0.3×log실구매 + 0.2×판매라벨</span>
      <span>점 크기 = 검증 점수 · 클릭·검색·인사이트 연동</span>
      {% if analysis.scatter.missing_count %}<span>활동 정보 없음 {{ analysis.scatter.missing_count }}개 제외</span>{% endif %}
    </div>
  </div>
</section>
{% endif %}

<section id="sec-outliers">
  <div class="sec-h"><h2>주목할 다섯</h2><p>순위·리뷰·할인·실시간 활동을 교차해 발견한 패턴</p></div>
  <div class="outliers">
  {% for group in analysis.outliers %}
    <div class="oc">
      <div class="oc-h"><div class="t">{{ group.title }}</div><div class="s">{{ group.subtitle }}</div></div>
      {% if group.cards %}
      <ul>
      {% for card in group.cards %}
        <li class="oc-row{% if card.is_sold_out %} sold{% endif %}">
          <span class="oc-rank">#{{ card.rank or '-' }}</span>
          <span class="oc-brand">{{ card.brand }}</span>
          <span class="oc-price">{{ card.price|currency }}원{% if card.discount_rate and card.discount_rate > 0 %} <em>-{{ card.discount_rate|percent }}</em>{% endif %}</span>
          <span class="oc-product">{% if card.url %}<a href="{{ card.url }}" target="_blank" rel="noopener">{{ card.product }}</a>{% else %}{{ card.product }}{% endif %}</span>
          {% if group.key == 'hot' %}
          <span class="heat-meta">
            <span>보는 중 <b>{{ card.viewers_now }}</b>명</span>
            <span>구매 중 <b>{{ card.buyers_now }}</b>명</span>
          </span>
          {% elif group.key == 'sales_strong' and card.sales_label_text %}
          <span class="heat-meta">
            <span><b>{{ card.sales_label_text }}</b></span>
            {% if card.review_count %}<span>리뷰 <b>{{ card.review_count }}</b>개</span>{% endif %}
          </span>
          {% elif group.key in ['hidden_validated', 'push_suspect'] %}
          <span class="heat-meta">
            <span>리뷰 <b>{{ card.review_count or 0 }}</b>개</span>
            <span>구매 중 <b>{{ card.buyers_now or 0 }}</b>명</span>
            {% if card.residual is defined %}<span>잔차 <b>{{ "%+.2f"|format(card.residual) }}</b></span>{% endif %}
          </span>
          {% elif card.review_count %}
          <span class="heat-meta"><span>리뷰 <b>{{ card.review_count }}</b>개</span></span>
          {% endif %}
        </li>
      {% endfor %}
      </ul>
      {% else %}
      <div class="oc-empty">조건에 해당하는 상품이 없습니다.</div>
      {% endif %}
    </div>
  {% endfor %}
  </div>
</section>

