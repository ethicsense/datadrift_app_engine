{%- macro card_row(card) -%}
  <li class="oc-row{% if card.is_sold_out %} sold{% endif %}">
    <span class="oc-rank">#{{ card.rank or '-' }}</span>
    <span class="oc-brand">{{ card.brand }}</span>
    <span class="oc-product">{% if card.url %}<a href="{{ card.url }}" target="_blank" rel="noopener">{{ card.product }}</a>{% else %}{{ card.product }}{% endif %}</span>
    <span class="oc-price">{{ card.price|currency }}원{% if card.discount_rate and card.discount_rate > 0 %} <em>-{{ card.discount_rate|percent }}</em>{% endif %}</span>
  </li>
{%- endmacro -%}
{%- macro thumb(image_url, brand, product) -%}
  <span class="thumb" aria-hidden="true">
    {% if image_url %}<img src="{{ image_url }}" loading="lazy" decoding="async" referrerpolicy="no-referrer" alt="">{% else %}{{ (brand or product or '·')[:1] }}{% endif %}
  </span>
{%- endmacro -%}
{%- macro pat_label(p) -%}
  {%- set _map = {'breakout':'급부상','steady_climb':'꾸준한 상승','stable_top':'스테디 톱','fading':'식어가는','classic_drop':'월간 잔존','entry_breakout':'신규 진입','mid_blip':'주간 깜빡','transient_dw':'일+주만','transient_wm':'주+월만','mixed':'혼합'} -%}
  {{ _map.get(p, p or '-') }}
{%- endmacro -%}
{%- macro pat_chip(p) -%}
  {%- set _ups = ['breakout','steady_climb','entry_breakout'] -%}
  {%- set _downs = ['fading','classic_drop'] -%}
  {%- set _flat = ['stable_top','mid_blip','transient_dw','transient_wm','mixed'] -%}
  <span class="pat-chip {% if p in _ups %}up{% elif p in _downs %}down{% else %}flat{% endif %}">{{ pat_label(p) }}</span>
{%- endmacro -%}
{%- macro insight_momentum_td(row) -%}
  <td class="num if-mom">{% if row.momentum_span is not none %}<b class="{% if row.momentum_span >= 0 %}pos{% else %}neg{% endif %}">{{ "%+.2f"|format(row.momentum_span) }}</b>{% else %}–{% endif %}</td>
{%- endmacro -%}
{%- macro insight_table_rows(rows) -%}
  {% for row in rows %}
  <tr class="chart-pick{% if row.is_sold_out %} sold{% endif %}" data-chart="rl" data-key="{{ row.key }}" tabindex="0" role="button" title="차트에서 강조">
    <td class="if-cell if-td-thumb">{{ thumb(row.image_url, row.brand, row.product) }}</td>
    <td class="if-cell">{{ row.brand }}</td>
    <td class="if-cell if-td-name">{% if row.url %}<a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.product }}</a>{% else %}{{ row.product }}{% endif %}</td>
    <td class="if-cell">{{ pat_chip(row.pattern or 'mixed') }}</td>
    {{ insight_momentum_td(row) }}
    <td class="num if-cell">{{ "%.2f"|format(row.sustained_rank_energy or 0) }}</td>
    <td class="if-cell if-td-chain"><span class="in-ft-chain">{% for seg in row.ranks_chain %}<span class="seg{% if not seg.observed %} miss{% endif %}">{{ seg.label }}{% if seg.observed %} #{{ seg.rank }}{% else %} –{% endif %}</span>{% endfor %}</span></td>
  </tr>
  {% endfor %}
{%- endmacro -%}
{%- macro event_table_rows(rows) -%}
  {% for row in rows %}
  <tr class="chart-pick{% if row.is_sold_out %} sold{% endif %}" data-chart="rl" data-key="{{ row.key }}" tabindex="0" role="button" title="차트에서 강조">
    <td class="if-cell if-td-thumb">{{ thumb(row.image_url, row.brand, row.product) }}</td>
    <td class="if-cell">{{ row.brand }}</td>
    <td class="if-cell if-td-name">{% if row.url %}<a href="{{ row.url }}" target="_blank" rel="noopener" onclick="event.stopPropagation()">{{ row.product }}</a>{% else %}{{ row.product }}{% endif %}</td>
    <td class="num if-cell">{% if row.event_strength is not none %}{{ "%.2f"|format(row.event_strength) }}{% else %}–{% endif %}</td>
    <td class="if-cell if-td-chain"><span class="in-ft-chain">{% for seg in row.ranks_chain %}<span class="seg{% if not seg.observed %} miss{% endif %}">{{ seg.label }}{% if seg.observed %} #{{ seg.rank }}{% else %} –{% endif %}</span>{% endfor %}</span></td>
  </tr>
  {% endfor %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>패션 동향 분석 보고서 · Silhouette</title>
<style>
:root{
  --bg:#fafafa;--surface:#ffffff;--ink:#0f0f10;--ink2:#5a5a64;--ink3:#9b9ba6;
  --line:#e7e7ec;--line2:#f0f0f4;--accent:#5546ff;--accent-soft:rgba(85,70,255,.08);
  --warn:#d97706;--alert:#dc2626;--ok:#0d8a4a;
  --pick-hi:#d91a72;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{background:var(--bg);color:var(--ink);overflow-x:clip;max-width:100%}
@supports not (overflow:clip){html,body{overflow-x:hidden}}
body{font-family:'Pretendard','Apple SD Gothic Neo',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;line-height:1.55;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:hover{text-decoration:underline}
.shell{max-width:1080px;margin:0 auto;padding:40px 32px 80px;min-width:0;width:100%}

/* App top: unified header + primary menu */
.app-top{
  position:relative;
  margin:0 0 28px;
  border:1px solid rgba(85,70,255,.14);
  border-radius:22px;
  overflow:hidden;
  background:
    radial-gradient(120% 140% at 0% 0%, rgba(85,70,255,.14) 0%, transparent 52%),
    radial-gradient(90% 100% at 100% 0%, rgba(13,138,74,.08) 0%, transparent 48%),
    linear-gradient(165deg, #ffffff 0%, #f7f7fc 48%, #f3f2ff 100%);
  box-shadow:
    0 1px 0 rgba(255,255,255,.9) inset,
    0 22px 48px -28px rgba(15,15,16,.22),
    0 8px 24px -16px rgba(85,70,255,.18);
}
.app-top__frame{position:relative}

/* Hero header (inside app-top) */
.hd-hero{
  position:relative;
  margin:0;
  padding:28px 32px 24px;
  border-radius:0;
  border:none;
  background:transparent;
  box-shadow:none;
  overflow:hidden;
}
.hd-hero::before{
  content:"";
  position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(15,15,16,.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(15,15,16,.03) 1px, transparent 1px);
  background-size:24px 24px;
  mask-image:linear-gradient(180deg, rgba(0,0,0,.35) 0%, transparent 70%);
  pointer-events:none;
}
.hd-hero__glow{
  position:absolute;
  width:280px;height:280px;
  right:-80px;top:-120px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(85,70,255,.22) 0%, transparent 68%);
  filter:blur(2px);
  pointer-events:none;
}
.app-top__context{
  position:relative;z-index:1;
  display:flex;align-items:flex-start;gap:12px;
  margin-top:18px;
  padding:12px 16px;
  border:1px solid var(--line);
  border-radius:12px;
  background:var(--bg);
}
.app-top__context-icon{
  flex:0 0 auto;
  width:34px;height:34px;
  display:flex;align-items:center;justify-content:center;
  border-radius:10px;
  background:var(--surface);
  border:1px solid var(--line);
  color:var(--ink3);
  font-size:15px;line-height:1;
}
.app-top__context-body{min-width:0;flex:1}
.app-top__context .hd-hero__lead{margin-top:0;font-size:13px}
.app-top__context .hd-hero__chips{margin-top:10px}
.hd-hero__inner{
  position:relative;z-index:1;
  display:flex;align-items:flex-end;justify-content:space-between;
  gap:28px;min-width:0;
}
.hd-hero__main{min-width:0;flex:1}
.hd-hero__eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  margin:0 0 14px;
  font-size:11px;font-weight:700;letter-spacing:.14em;
  text-transform:uppercase;color:var(--accent);
}
.hd-hero__mark{
  width:7px;height:7px;border-radius:50%;
  background:linear-gradient(135deg, #7c6cff 0%, #5546ff 100%);
  box-shadow:0 0 0 4px rgba(85,70,255,.18);
}
.hd-hero__title{
  font-size:clamp(32px, 5vw, 48px);
  font-weight:800;letter-spacing:-.04em;line-height:1.08;
  background:linear-gradient(120deg, #0f0f10 10%, #3b3b48 55%, #0f0f10 100%);
  -webkit-background-clip:text;background-clip:text;
  color:transparent;
}
.hd-hero__lead{
  margin-top:12px;
  font-size:14px;color:var(--ink2);line-height:1.6;
  max-width:42em;
}
.hd-hero__chips{
  display:flex;flex-wrap:wrap;gap:8px;
  margin-top:14px;
}
.hd-hero__chip{
  display:inline-flex;align-items:center;gap:6px;
  padding:5px 11px;border-radius:999px;
  font-size:11px;font-weight:600;letter-spacing:-.01em;
  border:1px solid var(--line);
  background:rgba(255,255,255,.72);
  color:var(--ink2);
  backdrop-filter:blur(6px);
}
.hd-hero__chip--accent{
  border-color:rgba(85,70,255,.28);
  background:rgba(85,70,255,.1);
  color:var(--accent);
}
.hd-hero__stats{
  display:grid;grid-template-columns:repeat(2, minmax(108px, 1fr));
  gap:10px;flex-shrink:0;
}
.hd-stat{
  padding:12px 14px;border-radius:14px;
  border:1px solid rgba(255,255,255,.65);
  background:rgba(255,255,255,.58);
  backdrop-filter:blur(10px);
  box-shadow:0 4px 14px -10px rgba(15,15,16,.25);
}
.hd-stat__lbl{
  font-size:10px;font-weight:600;letter-spacing:.06em;
  text-transform:uppercase;color:var(--ink3);margin-bottom:4px;
}
.hd-stat__val{
  font-size:20px;font-weight:800;letter-spacing:-.03em;
  font-variant-numeric:tabular-nums;color:var(--ink);line-height:1.1;
}
.hd-stat__val small{
  font-size:12px;font-weight:600;color:var(--ink2);margin-left:2px;
}

/* In-page TOC: single-row horizontal scroll tab strip */
.report-nav-wrap{
  position:sticky;top:0;z-index:200;
  width:100%;max-width:100%;margin:0 0 40px;
  background:rgba(250,250,250,.88);
  -webkit-backdrop-filter:saturate(180%) blur(10px);
  backdrop-filter:saturate(180%) blur(10px);
  border-top:1px solid var(--line);
  border-bottom:1px solid var(--line);
  overflow:hidden;
}
.report-nav-wrap::before,
.report-nav-wrap::after{
  content:"";
  position:absolute;top:0;bottom:0;
  width:32px;z-index:1;
  pointer-events:none;
}
.report-nav-wrap::before{
  left:0;
  background:linear-gradient(to right,rgba(250,250,250,.95) 20%,rgba(250,250,250,0));
}
.report-nav-wrap::after{
  right:0;
  background:linear-gradient(to left,rgba(250,250,250,.95) 20%,rgba(250,250,250,0));
}
.report-nav{
  position:relative;z-index:0;
  max-width:1080px;margin:0 auto;
  display:flex;flex-wrap:nowrap;align-items:stretch;
  gap:0;
  padding:0 32px;
  overflow-x:auto;overflow-y:hidden;
  -webkit-overflow-scrolling:touch;
  scroll-behavior:smooth;
  scroll-padding-inline:32px;
  scrollbar-width:none;
}
.report-nav::-webkit-scrollbar{display:none}
.report-nav a{
  position:relative;
  display:inline-flex;align-items:center;
  flex-shrink:0;
  white-space:nowrap;
  padding:12px 14px;
  color:var(--ink2);
  text-decoration:none;
  font-size:13px;font-weight:500;letter-spacing:-.01em;
  transition:color .15s ease;
}
.report-nav a::after{
  content:"";
  position:absolute;
  left:10px;right:10px;bottom:-1px;
  height:2px;
  background:transparent;
  transition:background .15s ease;
}
.report-nav a:hover{
  color:var(--accent);
  text-decoration:none;
}
.report-nav a:hover::after{background:var(--accent)}
.report-nav a:focus-visible{
  outline:2px solid var(--accent);
  outline-offset:-2px;
  border-radius:4px;
}

/* Section anchors: clear sticky bar */
section[id]{scroll-margin-top:60px}
details#sec-full-list{scroll-margin-top:60px}

/* Section */
section{margin:48px 0 0}
.sec-h{display:flex;align-items:baseline;gap:14px;margin-bottom:18px}
.sec-h h2{font-size:18px;font-weight:700;letter-spacing:-.3px;line-height:1.3;flex-shrink:0}
.sec-h p{font-size:12px;color:var(--ink3)}

/* KPI strip */
.kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.kpi .card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px}
.kpi .lbl{font-size:11px;letter-spacing:.06em;color:var(--ink3);text-transform:uppercase;margin-bottom:6px}
.kpi .val{font-size:28px;font-weight:700;letter-spacing:-1px;font-variant-numeric:tabular-nums}
.kpi .sub{font-size:11px;color:var(--ink3);margin-top:2px}

/* Scatter (ranking x review) */
.scatter-wrap{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:20px;overflow:hidden}
.scatter-legend{display:flex;flex-wrap:wrap;gap:14px;color:var(--ink2);font-size:12px;margin-top:10px}
.scatter-legend .dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--accent);margin-right:6px;vertical-align:1px}
.scatter-svg{width:100%;height:auto;display:block}
.scatter-svg .axis{stroke:#d4d4dc;stroke-width:1}
.scatter-svg .trend{stroke:#0f0f10;stroke-width:1.5;stroke-dasharray:5 4;opacity:.55}
.scatter-svg .tick-label{font:11px 'Pretendard',sans-serif;fill:var(--ink3)}
.scatter-svg .pt{fill-opacity:.6;stroke:#fff;stroke-width:1.2;cursor:pointer;transition:fill-opacity .15s,r .15s}
.scatter-svg .pt:hover{fill-opacity:1}
.scatter-svg .pt-above{fill:var(--ok)}
.scatter-svg .pt-below{fill:var(--warn)}
.scatter-svg .ol{font:600 10px 'Pretendard',sans-serif;fill:var(--ink);letter-spacing:.2px;pointer-events:none}
.scatter-svg .ol-above{fill:var(--ok)}
.scatter-svg .ol-below{fill:var(--warn)}
.scatter-legend .dot-above{background:var(--ok)}
.scatter-legend .dot-below{background:var(--warn)}
.scatter-tip{position:absolute;background:#0f0f10;color:#fff;padding:8px 11px;border-radius:8px;font-size:12px;pointer-events:none;opacity:0;transition:opacity .12s;white-space:nowrap;line-height:1.5;box-shadow:0 4px 14px rgba(0,0,0,.18)}
.scatter-tip b{color:#fff;font-weight:600}
.scatter-tip em{color:#a5a5b6;font-style:normal;margin-left:6px}
.scatter-rel{position:relative}

/* Outliers */
.outliers{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}
.oc{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.oc-h{margin-bottom:12px}
.oc-h .t{font-weight:700;font-size:14px}
.oc-h .s{font-size:11px;color:var(--ink3);margin-top:2px}
.oc ul{list-style:none;display:flex;flex-direction:column;gap:8px}
.oc-row{display:grid;grid-template-columns:32px 1fr auto;grid-template-rows:auto auto;column-gap:8px;font-size:12px;align-items:center}
.oc-rank{grid-row:1/3;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
.oc-brand{font-weight:600;color:var(--ink)}
.oc-price{text-align:right;font-variant-numeric:tabular-nums;color:var(--ink2);font-size:11px}
.oc-price em{font-style:normal;color:var(--warn);font-weight:600;margin-left:4px}
.oc-product{grid-column:2/4;color:var(--ink2);font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.oc-row.sold .oc-product{text-decoration:line-through;color:var(--ink3)}
.oc-empty{font-size:12px;color:var(--ink3);padding:12px 0}

/* Heat top extra (viewers/buyers bars) */
.heat-meta{font-size:11px;color:var(--ink3);grid-column:2/4;display:flex;gap:10px;margin-top:1px}
.heat-meta span b{color:var(--ink2);font-weight:600}

/* Brand concentration */
.bc-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:16px}
@media(max-width:780px){.bc-grid{grid-template-columns:1fr}}
.bc-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 20px}
.bc-card h3{font-size:13px;font-weight:600;color:var(--ink2);margin-bottom:14px}
.bar-row{display:flex;align-items:center;gap:10px;font-size:12px;margin-bottom:6px}
.bar-row .lbl{width:120px;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bar-row .tr{flex:1;height:18px;background:var(--line2);border-radius:5px;position:relative;overflow:hidden}
.bar-row .fl{position:absolute;left:0;top:0;bottom:0;background:var(--accent);border-radius:5px}
.bar-row .vl{width:64px;text-align:right;color:var(--ink2);font-variant-numeric:tabular-nums}
.bar-row .vl b{color:var(--ink);font-weight:600}
.bc-other{display:flex;justify-content:space-between;font-size:12px;color:var(--ink3);margin-top:8px;padding-top:10px;border-top:1px dashed var(--line)}

/* HHI bullet */
.hhi-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:12px}
.hhi-val{font-size:34px;font-weight:800;letter-spacing:-1.5px}
.hhi-lvl{font-size:12px;font-weight:600;padding:3px 9px;border-radius:999px;background:var(--accent-soft);color:var(--accent)}
.hhi-lvl.l-concentrated{background:rgba(220,38,38,.1);color:var(--alert)}
.hhi-lvl.l-diffuse{background:rgba(13,138,74,.1);color:var(--ok)}
.bullet-track{position:relative;height:14px;background:linear-gradient(to right,rgba(13,138,74,.18) 0%,rgba(13,138,74,.18) var(--diffuse,37.5%),rgba(217,119,6,.18) var(--diffuse,37.5%),rgba(217,119,6,.18) var(--concentrated,62.5%),rgba(220,38,38,.18) var(--concentrated,62.5%),rgba(220,38,38,.18) 100%);border-radius:7px;margin:8px 0 6px}
.bullet-marker{position:absolute;top:-4px;width:3px;height:22px;background:var(--ink);border-radius:2px}
.bullet-ticks{display:flex;justify-content:space-between;font-size:10px;color:var(--ink3)}
.bc-note{font-size:12px;color:var(--ink2);margin-top:14px;line-height:1.6}

/* Dot strip */
.dotstrip-wrap{
  --price-zoom:#52d49a;
  --price-zoom-soft:rgba(82,212,154,.22);
  --price-zoom-border:#2db872;
  --price-zoom-ink:#1a7a4c;
  background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 20px
}
.dotstrip-wrap .chart-toolbar{margin-bottom:12px}
.dotstrip-range-label{font-size:12px;color:var(--ink2);margin-left:8px}
.dotstrip-stats{font-size:12px;color:var(--ink2);margin-bottom:8px;min-height:1.2em}
.dotstrip-rel{position:relative;max-width:100%}
.dotstrip-rel .dotstrip-svg{min-height:120px}
.dotstrip-tip{position:absolute;z-index:30;background:#0f0f10;color:#fff;padding:8px 11px;border-radius:8px;font-size:12px;pointer-events:none;opacity:0;transition:opacity .08s;line-height:1.5;box-shadow:0 4px 14px rgba(0,0,0,.18);max-width:300px;white-space:normal}
.dotstrip-tip b{color:#fff;font-weight:600}
.dotstrip-tip em{color:#a5a5b6;font-style:normal;margin-left:6px}
.dotstrip-svg{width:100%;height:auto;display:block;touch-action:none}
.dotstrip-svg .axis{stroke:#d4d4dc;stroke-width:1}
.dotstrip-svg .tick{font:10px 'Pretendard',sans-serif;fill:var(--ink3)}
.dotstrip-svg .tick-major{font-size:11px;font-weight:600;fill:var(--ink2)}
.dotstrip-svg .d{fill:var(--accent);fill-opacity:.45;stroke:#fff;stroke-width:.8;cursor:pointer;transition:fill-opacity .1s,opacity .1s,stroke-width .1s}
.dotstrip-svg .d.sold{fill:var(--ink3)}
.dotstrip-svg .d.d-hover{fill-opacity:1;stroke:var(--ink);stroke-width:1.6}
.dotstrip-rel.is-tip-on .dotstrip-svg .d:not(.d-hover){fill-opacity:.22}
.dotstrip-wrap.has-filter .dotstrip-svg .d:not(.in-range){fill-opacity:.12;opacity:.35}
.dotstrip-wrap.has-filter .dotstrip-svg .d.in-range{fill-opacity:.75}
.dotstrip-wrap.has-filter .dotstrip-rel.is-tip-on .dotstrip-svg .d.in-range:not(.d-hover){fill-opacity:.45}
.price-brush-overlay{fill:var(--price-zoom-soft);stroke:var(--price-zoom-border);stroke-width:1.5;pointer-events:none}
.price-preset-btn.is-range-hit{background:var(--price-zoom-soft);border-color:var(--price-zoom-border);color:var(--price-zoom-ink);font-weight:600}
.price-preset-btn[aria-pressed="true"].is-range-hit{background:var(--price-zoom-soft);border-color:var(--price-zoom-border);color:var(--price-zoom-ink)}

/* Age rankings (realtime × age tabs) */
.age-rank-wrap .heat-toolbar{margin-bottom:14px;flex-wrap:wrap;align-items:center;gap:10px}
.age-rank-active-chip strong{color:var(--accent)}
.age-rank-panels{margin-top:4px}
.age-rank-panel{display:none}
.age-rank-panel.is-active{display:block}
.age-rank-panel-title{font-size:15px;font-weight:700;color:var(--ink);margin:0 0 10px}
.age-rank-panel-title em{font-style:normal;color:var(--accent);font-weight:700}
.age-rank-scroll{overflow:auto;max-height:min(420px,50vh);border:1px solid var(--line2);border-radius:10px;-webkit-overflow-scrolling:touch}
.age-rank-scroll .pt-table{margin:0}
.age-rank-foot{font-size:11px;color:var(--ink3);margin-top:8px}
.age-rank-tab[aria-pressed="true"]{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}

/* Customer signals tab */
.cs-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:0 0 28px}
@media(max-width:760px){.cs-summary{grid-template-columns:1fr}}
.cs-summary .card{padding:14px 16px;border:1px solid var(--line2);border-radius:10px;background:var(--surface)}
.cs-summary .card .lbl{font-size:11px;color:var(--ink3);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px}
.cs-summary .card .val{font-size:22px;font-weight:700;color:var(--ink)}
.cs-summary .card .sub{font-size:11px;color:var(--ink3);margin-top:4px;line-height:1.4}
.cs-block{margin-top:36px}
.cs-block:first-of-type{margin-top:0}
.cs-content-scroll,.cs-keyword-scroll{overflow:auto;max-height:min(520px,60vh);border:1px solid var(--line2);border-radius:10px;-webkit-overflow-scrolling:touch}
.cs-content-scroll .pt-table,.cs-keyword-scroll .pt-table{margin:0}
.cs-nested-products{font-size:11px;color:var(--ink3);margin-top:4px}
.cs-product-chips{display:flex;flex-wrap:wrap;gap:6px;max-width:420px}
.cs-product-chip{display:flex;align-items:center;gap:6px;min-width:0;max-width:100%;padding:5px 8px 5px 5px;border:1px solid var(--line2);border-radius:8px;background:var(--surface);font-size:10px;line-height:1.35;color:var(--ink2);text-decoration:none}
a.cs-product-chip:hover{border-color:var(--accent);background:var(--accent-soft)}
.cs-product-chip .thumb{width:32px;height:32px;border-radius:5px;font-size:10px}
.cs-product-chip-body{min-width:0;display:flex;flex-direction:column;gap:1px}
.cs-product-chip-title{font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px}
.cs-product-chip-meta{font-size:9px;color:var(--ink3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cs-product-chip-rank{font-size:9px;font-weight:700;color:var(--accent);letter-spacing:.02em}
.cs-product-more{align-self:center;font-size:10px;color:var(--ink3);padding:4px 8px;border:1px dashed var(--line2);border-radius:8px;white-space:nowrap}
.cs-fl-up{color:#c62828;font-weight:600}
.cs-fl-down{color:#1565c0;font-weight:600}
.cs-fl-flat{color:var(--ink3)}
.cs-keyword-tab[aria-pressed="true"]{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
.cs-keyword-panel{display:none}
.cs-keyword-panel.is-active{display:block}
.cs-heatmap-panel{display:none}
.cs-heatmap-panel.is-active{display:block}
.cs-heatmap-cat-toolbar{margin-bottom:14px}
.heat-gender.cs-heatmap-cat-tabs .cs-heatmap-cat-btn::before{display:none}
.heat-gender.cs-heatmap-cat-tabs .cs-heatmap-cat-btn{
  color:var(--ink2);
  background:transparent;
}
.heat-gender.cs-heatmap-cat-tabs .cs-heatmap-cat-btn[aria-pressed="true"]{
  background:var(--accent-soft);
  color:var(--accent);
  font-weight:700;
  box-shadow:inset 0 0 0 1px rgba(85,70,255,.22);
}
.heat-gender.cs-heatmap-cat-tabs .cs-heatmap-cat-btn:not([aria-pressed="true"]):hover{
  background:var(--line2);
  color:var(--ink);
}
.cs-heatmap-cat-chip strong{color:var(--accent)}
.age-rank-tab[aria-pressed="true"][data-age="all"]{background:#ecebff;border-color:#847bff;color:#473dff}
.age-rank-tab[aria-pressed="true"][data-age="u19"]{background:#ffeef1;border-color:#ff7a98;color:#c22d53}
.age-rank-tab[aria-pressed="true"][data-age="20_24"]{background:#ebf7ff;border-color:#69bfff;color:#1261a4}
.age-rank-tab[aria-pressed="true"][data-age="25_29"]{background:#eefaf1;border-color:#72cf86;color:#1b7a34}
.age-rank-tab[aria-pressed="true"][data-age="30_34"]{background:#fff5e9;border-color:#ffbf76;color:#9a5e13}
.age-rank-tab[aria-pressed="true"][data-age="35_39"]{background:#f4f0ff;border-color:#b79cff;color:#5c3ba0}
.age-rank-tab[aria-pressed="true"][data-age="40p"]{background:#f1f2f6;border-color:#9fa4b2;color:#3e4454}
.cs-keyword-tab[aria-pressed="true"][data-gender="all"]{background:#ecebff;border-color:#847bff;color:#473dff}
.cs-keyword-tab[aria-pressed="true"][data-gender="male"]{background:#ebf7ff;border-color:#69bfff;color:#1261a4}
.cs-keyword-tab[aria-pressed="true"][data-gender="female"]{background:#ffeef1;border-color:#ff7a98;color:#c22d53}

/* Heatmap (price × age) — chromatophore-style staggered color morph */
@property --cell-tone{
  syntax:"<color>";
  inherits:false;
  initial-value:#5546ff;
}
@property --a{
  syntax:"<number>";
  inherits:false;
  initial-value:0;
}
.heat-wrap{
  --g-all:#5546ff;
  --g-all-soft:rgba(85,70,255,.10);
  --g-male:#1d6fd9;
  --g-male-soft:rgba(29,111,217,.10);
  --g-female:#e0457b;
  --g-female-soft:rgba(224,69,123,.10);
  --g-active:var(--g-all);
  --g-active-soft:var(--g-all-soft);
}
.heat-wrap[data-active-gender="male"]{--g-active:var(--g-male);--g-active-soft:var(--g-male-soft)}
.heat-wrap[data-active-gender="female"]{--g-active:var(--g-female);--g-active-soft:var(--g-female-soft)}
.heat{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 20px}
.heat-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;margin-bottom:14px}
.heat-toolbar .lbl{font-size:11px;font-weight:600;color:var(--ink3);letter-spacing:.04em}
.heat-window-chip{
  display:inline-flex;align-items:center;gap:6px;
  padding:5px 11px;border-radius:999px;font-size:11px;font-weight:600;
  border:1px solid rgba(85,70,255,.22);background:var(--accent-soft);color:var(--accent);
}
.heat-gender{
  display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--bg);
  transition:border-color .25s ease;
}
.heat-gender button{
  position:relative;
  border:none;background:transparent;padding:7px 14px;font-size:12px;font-weight:600;color:var(--ink2);
  cursor:pointer;transition:background .25s ease,color .25s ease;
}
.heat-gender button::before{
  content:"";display:inline-block;width:8px;height:8px;border-radius:50%;
  margin-right:6px;vertical-align:1px;background:currentColor;opacity:.85;
}
.heat-gender button[data-gender="all"]{color:var(--g-all)}
.heat-gender button[data-gender="male"]{color:var(--g-male)}
.heat-gender button[data-gender="female"]{color:var(--g-female)}
.heat-gender button[aria-pressed="true"]{background:var(--g-active-soft);color:var(--g-active)}
.heat-gender button[disabled]{opacity:.4;cursor:not-allowed}
.heat-bar-mode{
  display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:var(--bg);
}
.heat-bar-mode button{
  border:none;background:transparent;padding:6px 12px;font-size:11px;font-weight:600;color:var(--ink2);
  cursor:pointer;transition:background .2s ease,color .2s ease;
}
.heat-bar-mode button[aria-pressed="true"]{background:var(--accent-soft);color:var(--accent)}
.heat-stage{
  position:relative;margin-top:6px;min-height:320px;
}
.heat-grid-scene{
  position:relative;z-index:1;
  transition:opacity .35s ease;
}
.heat-wrap[data-heat-view="bars"] .heat-grid-scene,
.heat-wrap[data-heat-view="transitioning"] .heat-grid-scene{
  opacity:0;pointer-events:none;
}
.heat-grid.is-gathering .heat-cell:not(.is-focus),
.heat-grid.is-gathering .heat-row-h:not(.is-focus),
.heat-grid.is-gathering .heat-col-h:not(.is-focus){
  opacity:0;
  transition:opacity .42s ease,transform .5s cubic-bezier(.4,0,.2,1);
}
.heat-grid.is-gathering[data-axis="row"] .heat-cell:not(.is-focus){
  transform:translateY(var(--gather-y,0));
}
.heat-grid.is-gathering[data-axis="col"] .heat-cell:not(.is-focus){
  transform:translateX(var(--gather-x,0));
}
.heat-grid.is-gathering .heat-cell.is-focus{
  transition:opacity .25s ease;
}
.heat-grid.is-handoff .heat-cell.is-focus,
.heat-grid.is-handoff .heat-row-h.is-focus,
.heat-grid.is-handoff .heat-col-h.is-focus{
  opacity:0;transition:opacity .28s ease;
}
.heat-merge-track{
  position:absolute;z-index:6;opacity:0;pointer-events:none;
  display:flex;align-items:stretch;
  transform-origin:center center;
  transition:
    opacity .25s ease,
    left .58s cubic-bezier(.4,.05,.2,1),
    top .58s cubic-bezier(.4,.05,.2,1),
    width .58s cubic-bezier(.4,.05,.2,1),
    height .58s cubic-bezier(.4,.05,.2,1),
    transform .62s cubic-bezier(.4,.05,.2,1);
}
.heat-merge-track.is-visible{opacity:1}
.heat-merge-track--row{flex-direction:row}
.heat-merge-track--col{flex-direction:column}
.heat-merge-track__seg{
  flex:1 1 0;min-width:0;min-height:0;
  background:var(--line2);
  transition:background .3s ease,color .3s ease;
}
.heat-merge-track--row .heat-merge-track__seg:first-child{border-radius:4px 0 0 4px}
.heat-merge-track--row .heat-merge-track__seg:last-child{border-radius:0 4px 4px 0}
.heat-merge-track--col .heat-merge-track__seg:first-child{border-radius:4px 4px 0 0}
.heat-merge-track--col .heat-merge-track__seg:last-child{border-radius:0 0 4px 4px}
.heat-chart-panel{
  position:absolute;left:0;right:0;top:0;bottom:0;z-index:2;
  display:flex;flex-direction:column;min-height:0;
  opacity:0;pointer-events:none;
  transition:opacity .42s ease .14s;
}
.heat-wrap[data-heat-view="bars"] .heat-chart-panel{
  opacity:1;pointer-events:auto;
}
.heat-chart-panel .heat-detail-top{
  flex:0 0 auto;display:grid;grid-template-columns:auto minmax(0,1fr) auto;
  align-items:center;gap:10px 14px;margin-bottom:10px;padding-bottom:0;border:none;
}
.heat-chart-panel .heat-detail-h{grid-column:2;min-width:0}
.heat-chart-panel .heat-detail-controls{grid-column:3;justify-self:end}
@media (max-width:720px){
  .heat-chart-panel .heat-detail-top{grid-template-columns:auto 1fr}
  .heat-chart-panel .heat-detail-controls{grid-column:1/-1;justify-self:start}
}
.heat-back-btn{
  flex-shrink:0;border:1px solid var(--line);background:var(--bg);border-radius:8px;
  padding:5px 10px;font-size:11px;font-weight:600;color:var(--ink2);cursor:pointer;
  transition:background .2s ease,color .2s ease,border-color .2s ease;
}
.heat-back-btn:hover{background:var(--g-active-soft);border-color:color-mix(in srgb,var(--g-active) 35%,var(--line));color:var(--g-active)}
.heat-grid{
  display:grid;grid-template-columns:auto repeat(7,minmax(0,1fr));gap:3px;align-items:stretch;
}
.heat-grid .h{
  font-size:10px;color:var(--ink3);text-align:center;font-variant-numeric:tabular-nums;padding:6px 2px;
  border-radius:4px;cursor:pointer;
  transition:background .38s cubic-bezier(.33,1,.48,1),color .38s cubic-bezier(.33,1,.48,1);
  transition-delay:.12s;
}
.heat-grid .h:hover,.heat-grid .h.is-selected{background:var(--g-active-soft);color:var(--g-active)}
.heat-grid .rl{
  font-size:11px;color:var(--ink2);font-weight:600;padding:8px 10px 8px 4px;text-align:right;align-self:center;
  cursor:pointer;border-radius:4px;
  transition:background .38s cubic-bezier(.33,1,.48,1),color .38s cubic-bezier(.33,1,.48,1);
  transition-delay:.12s;
}
.heat-grid .rl:hover,.heat-grid .rl.is-selected{background:var(--g-active-soft);color:var(--g-active)}
.heat-cell{
  --heat-duration:.52s;
  --heat-stagger:.36s;
  --heat-ease:cubic-bezier(.33,1,.48,1);
  --cell-tone:var(--g-all);
  --a-mix:calc(var(--a,0) * 100%);
  aspect-ratio:1.35/1;border-radius:5px;display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:600;color:#fff;font-variant-numeric:tabular-nums;
  background:color-mix(in srgb,var(--cell-tone) var(--a-mix),var(--line2));
  transition:
    --cell-tone var(--heat-duration) var(--heat-ease),
    --a var(--heat-duration) var(--heat-ease),
    color var(--heat-duration) var(--heat-ease),
    opacity .3s ease,
    transform .38s cubic-bezier(.4,.05,.2,1);
  transition-delay:calc((1 - var(--density,0)) * var(--heat-stagger));
}
.heat-wrap.heat-gender-all .heat-cell:not(.empty){--cell-tone:var(--g-all)}
.heat-wrap.heat-gender-male .heat-cell:not(.empty){--cell-tone:var(--g-male)}
.heat-wrap.heat-gender-female .heat-cell:not(.empty){--cell-tone:var(--g-female)}
.heat-cell.empty{
  --cell-tone:var(--line2);--a:0;--density:0;
  background:var(--line2);color:transparent;--a-mix:0%;
  transition:none;
}
.heat-cell.dim{color:var(--ink2)}
@media (prefers-reduced-motion:reduce){
  .heat-cell,.heat-grid .h,.heat-grid .rl{transition:none;transition-delay:0}
  .heat-grid-scene,.heat-chart-panel,.heat-merge-track,.heat-merge-track__seg{transition:none}
}
.heat-detail-top{
  display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 14px;
}
.heat-detail-h{flex:1;min-width:12em;font-size:13px;font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums}
.heat-detail-controls{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px}
.heat-detail-controls .lbl{font-size:11px;font-weight:600;color:var(--ink3);letter-spacing:.04em}
.heat-legend{display:none;align-items:center;gap:10px;font-size:11px;color:var(--ink2)}
.heat-legend .sw{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:4px;vertical-align:-1px}
.heat-wrap[data-bar-mode="compare"] .heat-legend{display:inline-flex}
.heat-bars{
  flex:1 1 auto;
  width:var(--bars-width,100%);max-width:var(--bars-width,100%);
  margin-left:var(--bars-inset-l,0);margin-right:0;
  box-sizing:border-box;
  display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:10px;
  align-items:end;min-height:200px;padding:14px 0 26px;
}
.heat-wrap[data-bar-mode="compare"] .heat-bars{gap:14px}
.heat-bar{
  min-width:0;min-height:0;display:flex;flex-direction:column;align-items:stretch;gap:6px;
  height:100%;justify-content:flex-end;
}
.heat-bar .stack{
  flex:1 1 auto;min-height:0;
  display:flex;align-items:flex-end;justify-content:center;gap:6px;
}
.heat-wrap[data-bar-mode="compare"] .heat-bar .stack{gap:4px}
.heat-bar .fill{
  flex:1;max-width:64px;min-width:8px;border-radius:8px 8px 3px 3px;
  background:linear-gradient(180deg,color-mix(in srgb,var(--g-active) 70%,white) 0%,var(--g-active) 100%);
  box-shadow:0 6px 14px -8px color-mix(in srgb,var(--g-active) 60%,transparent);
  position:relative;height:2px;
  transition:height .55s cubic-bezier(.22,.61,.36,1),background .35s ease,opacity .25s ease;
}
.heat-bar .fill[data-gender="all"]{background:linear-gradient(180deg,color-mix(in srgb,var(--g-all) 70%,white) 0%,var(--g-all) 100%);box-shadow:0 6px 14px -8px color-mix(in srgb,var(--g-all) 60%,transparent)}
.heat-bar .fill[data-gender="male"]{background:linear-gradient(180deg,color-mix(in srgb,var(--g-male) 70%,white) 0%,var(--g-male) 100%);box-shadow:0 6px 14px -8px color-mix(in srgb,var(--g-male) 60%,transparent)}
.heat-bar .fill[data-gender="female"]{background:linear-gradient(180deg,color-mix(in srgb,var(--g-female) 70%,white) 0%,var(--g-female) 100%);box-shadow:0 6px 14px -8px color-mix(in srgb,var(--g-female) 60%,transparent)}
.heat-bar .fill .val{
  position:absolute;top:-18px;left:50%;transform:translateX(-50%);
  font-size:11px;font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums;
  opacity:0;transition:opacity .25s ease .25s;
}
.heat-bar .fill.is-shown .val{opacity:1}
.heat-bar .lbl{
  font-size:11px;color:var(--ink2);text-align:center;line-height:1.25;word-break:keep-all;
  font-weight:600;margin-top:4px;
}

/* Quality footer */
.qf{display:flex;justify-content:space-between;align-items:center;margin-top:48px;padding:18px 22px;background:var(--surface);border:1px solid var(--line);border-radius:14px;font-size:12px}
.qf .left{display:flex;gap:10px;align-items:center;color:var(--ink2)}
.qf .badge{font-size:10px;font-weight:700;letter-spacing:.08em;padding:3px 8px;border-radius:4px;text-transform:uppercase;background:rgba(13,138,74,.12);color:var(--ok)}
.qf .badge.bad{background:rgba(220,38,38,.12);color:var(--alert)}
.qf .right{color:var(--ink3);font-family:'JetBrains Mono','Menlo',monospace;font-size:11px}

/* Tables (inside details) */
details{margin-top:14px}
details summary{cursor:pointer;font-size:12px;color:var(--ink2);font-weight:600;padding:8px 12px;background:var(--surface);border:1px solid var(--line);border-radius:8px;list-style:none;display:inline-block}
details summary::-webkit-details-marker{display:none}
details summary::after{content:" ▾";color:var(--ink3)}
details[open] summary::after{content:" ▴"}
.tw{margin-top:12px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface)}
.tw table{width:100%;border-collapse:collapse;font-size:12px}
.tw thead{background:var(--line2)}
.tw th{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink3);padding:9px 12px;text-align:left;font-weight:600;border-bottom:1px solid var(--line)}
.tw td{padding:8px 12px;border-bottom:1px solid var(--line2);vertical-align:middle}
.tw tr:last-child td{border-bottom:none}
.tw td.win{font-weight:600;color:var(--accent)}

/* Cross-window momentum dashboard */
.cw-wrap{display:grid;grid-template-columns:1fr;gap:14px;min-width:0;max-width:100%}
.cw-card{min-width:0;max-width:100%}
.cw-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 20px}
.cw-card h3{font-size:13px;font-weight:600;color:var(--ink2);margin-bottom:10px}
.cw-grid-2{display:grid;grid-template-columns:1.6fr 1fr;gap:14px;min-width:0;max-width:100%}
@media(max-width:880px){.cw-grid-2{grid-template-columns:1fr}}
.rl-svg{width:100%;height:auto;display:block}
.rl-svg .axis{stroke:#d4d4dc;stroke-width:1}
.rl-svg .gridline{stroke:#ececf2;stroke-width:1;stroke-dasharray:3 4}
.rl-svg .tick-label{font:11px 'Pretendard',sans-serif;fill:var(--ink3)}
.rl-svg .col-line{stroke:#ececf2;stroke-width:1}
.rl-svg .pl{fill:none;stroke-width:1.5;opacity:.5;transition:opacity .15s,stroke-width .15s}
.rl-svg .pl-up{stroke:var(--ok)}
.rl-svg .pl-down{stroke:var(--warn)}
.rl-svg .pl-flat{stroke:var(--ink3)}
.rl-svg .pl-event{stroke:var(--accent);opacity:.45}
.rl-svg .pl.dim{opacity:.2}
.rl-svg .pl.hl{opacity:.95;stroke-width:2.4}
.rl-svg .pl:hover{opacity:1;stroke-width:2.6}
.rl-svg .nd{fill:#fff;stroke-width:1.4;cursor:pointer;transition:r .15s}
.rl-svg .nd-up{stroke:var(--ok)}
.rl-svg .nd-down{stroke:var(--warn)}
.rl-svg .nd-flat{stroke:var(--ink3)}
.rl-svg .nd-event{stroke:var(--accent)}
.rl-svg .nd:hover{r:5.2}
/* Group filter: dim everything, then re-emphasize chosen colors. Multi-select supported. */
.rl-rel.has-filter .rl-svg .pl{opacity:.05}
.rl-rel.has-filter .rl-svg .nd{opacity:.08}
.rl-rel.filter-up .rl-svg .pl-up{opacity:.75}
.rl-rel.filter-up .rl-svg .pl-up.hl{opacity:1;stroke-width:2.8}
.rl-rel.filter-up .rl-svg .nd-up{opacity:1}
.rl-rel.filter-down .rl-svg .pl-down{opacity:.8}
.rl-rel.filter-down .rl-svg .pl-down.hl{opacity:1;stroke-width:2.8}
.rl-rel.filter-down .rl-svg .nd-down{opacity:1}
.rl-rel.filter-flat .rl-svg .pl-flat{opacity:.7}
.rl-rel.filter-flat .rl-svg .pl-flat.hl{opacity:1;stroke-width:2.8}
.rl-rel.filter-flat .rl-svg .nd-flat{opacity:1}
.rl-svg .axlbl{font:600 11px 'Pretendard',sans-serif;fill:var(--ink2)}
.rl-svg .axlbl-d{font:11px 'Pretendard',sans-serif;fill:var(--ink3)}
.cw-legend{display:flex;flex-wrap:wrap;align-items:center;gap:8px;color:var(--ink2);font-size:11px;margin-top:10px}
.cw-legend .swatch{display:inline-block;width:12px;height:3px;border-radius:2px;background:var(--ink3);vertical-align:3px;margin-right:5px}
.cw-legend .sw-up{background:var(--ok)}
.cw-legend .sw-down{background:var(--warn)}
.cw-legend .sw-flat{background:var(--ink3)}
.cw-legend .leg-btn{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:99px;border:1px solid var(--line);background:transparent;cursor:pointer;font:inherit;color:var(--ink2);transition:background .12s,border-color .12s,color .12s;font-variant-numeric:tabular-nums;font-size:11px}
.cw-legend .leg-btn:hover{background:var(--line2)}
.cw-legend .leg-btn[aria-pressed="true"]{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
.cw-legend .leg-btn[data-filter="up"][aria-pressed="true"]{background:rgba(13,138,74,.12);border-color:var(--ok);color:var(--ok)}
.cw-legend .leg-btn[data-filter="up"][aria-pressed="true"] .swatch{background:var(--ok)}
.cw-legend .leg-btn[data-filter="down"][aria-pressed="true"]{background:rgba(217,119,6,.14);border-color:var(--warn);color:var(--warn)}
.cw-legend .leg-btn[data-filter="down"][aria-pressed="true"] .swatch{background:var(--warn)}
.cw-legend .leg-btn[data-filter="flat"][aria-pressed="true"]{background:var(--line2);border-color:var(--ink3);color:var(--ink2)}
.cw-legend .leg-btn b{font-weight:700;color:inherit}
.cw-legend .leg-reset{display:none;padding:4px 10px;border-radius:99px;border:1px dashed var(--line);background:transparent;cursor:pointer;color:var(--ink3);font-size:11px}
.cw-legend.has-filter .leg-reset{display:inline-flex}
.cw-legend .leg-spacer{flex:1}
.cw-legend .leg-hint{font-size:11px;color:var(--ink3)}
.rl-rel{position:relative;max-width:100%;overflow:hidden}
.rl-rel .rl-svg{min-height:280px}
.rl-tip{position:absolute;background:#0f0f10;color:#fff;padding:8px 11px;border-radius:8px;font-size:12px;pointer-events:none;opacity:0;transition:opacity .12s;white-space:nowrap;line-height:1.5;box-shadow:0 4px 14px rgba(0,0,0,.18);max-width:280px;white-space:normal}
.rl-tip b{color:#fff;font-weight:600}
.rl-tip em{color:#a5a5b6;font-style:normal;margin-left:6px}
.rl-rel.has-focus .pl:not(.focus-on){opacity:.06!important;stroke-width:1.2!important}
.rl-rel.has-focus .nd:not(.focus-on){opacity:.1!important}
.rl-rel.has-focus .pl.focus-on,.rl-rel.has-focus .nd.focus-on{opacity:1!important}
.rl-rel.has-focus .pl.focus-on{stroke-width:2.8!important}
.chart-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;margin-bottom:12px}
.chart-presets{display:flex;flex-wrap:wrap;gap:6px}
.chart-preset-btn{padding:5px 11px;border-radius:99px;border:1px solid var(--line);background:var(--surface);cursor:pointer;font:inherit;font-size:11px;font-weight:600;color:var(--ink2);transition:background .12s,border-color .12s,color .12s}
.chart-preset-btn:hover{background:var(--line2)}
.chart-preset-btn[aria-pressed="true"]{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
.chart-search{flex:1;min-width:140px;max-width:240px;padding:6px 10px;border:1px solid var(--line);border-radius:8px;font:inherit;font-size:12px;background:var(--surface);color:var(--ink)}
.chart-search:focus{outline:2px solid var(--accent-soft);border-color:var(--accent)}
.chart-focus-clear{padding:5px 10px;border-radius:8px;border:1px dashed var(--line);background:transparent;cursor:pointer;font:inherit;font-size:11px;color:var(--ink3)}
.chart-focus-clear:not([hidden]){display:inline-flex}
.chart-pick{cursor:pointer;transition:background .12s}
.chart-pick:hover,.chart-pick.chart-pick--on{background:var(--accent-soft)}
.chart-pick:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.in-row.chart-pick{border-radius:8px;margin:0 -6px;padding:4px 6px}
.scatter-rel .scatter-svg{min-height:280px}
.scatter-rel.has-focus .pt:not(.focus-on){fill-opacity:.08!important}
.scatter-rel.has-focus .pt.focus-on{fill-opacity:1!important;stroke-width:2px}

/* Momentum distribution histogram (horizontal bars) */
.mh{display:flex;flex-direction:column;gap:2px;margin-top:4px}
.mh-row{display:grid;grid-template-columns:102px 1fr 28px;align-items:center;gap:8px;font-size:11px;line-height:1.2;width:100%;margin:0;padding:1px 2px;border:0;border-radius:4px;background:transparent;font:inherit;color:inherit;text-align:inherit;cursor:pointer;transition:background .1s}
.mh-row:hover:not(.mh-row--off){background:var(--line2)}
.mh-row[aria-pressed="true"]{background:var(--accent-soft);box-shadow:inset 0 0 0 1px var(--accent)}
.mh-row.mh-row--off{opacity:.45;cursor:default}
.mh-row .mh-lbl{color:var(--ink3);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap;font-size:10px}
.mh-row .mh-tr{height:12px;background:var(--line2);border-radius:3px;position:relative;overflow:hidden}
.mh-row .mh-fl{position:absolute;left:0;top:0;bottom:0;border-radius:4px}
.mh-row .mh-fl.neg{background:var(--warn);opacity:.75}
.mh-row .mh-fl.pos{background:var(--ok);opacity:.75}
.mh-row .mh-fl.mid{background:var(--ink3);opacity:.55}
.mh-row .mh-val{font-variant-numeric:tabular-nums;color:var(--ink2);text-align:right;font-size:11px}
.mh-meta-sub{font-size:10px;color:var(--ink3)}
.mh-meta{font-size:11px;color:var(--ink3);margin-top:10px;display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px}
.mh-meta b{color:var(--ink2)}
.mh-reset{display:none;padding:4px 10px;border-radius:99px;border:1px dashed var(--line);background:transparent;cursor:pointer;color:var(--ink3);font:inherit;font-size:11px}
.mh-card.has-bin .mh-reset,.mh-card.has-event .mh-reset{display:inline-flex}
.mh-hint{font-size:11px;color:var(--ink3);margin-top:8px;line-height:1.45}
.ev-section{margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
.ev-section h4{font-size:12px;font-weight:600;color:var(--ink2);margin-bottom:8px}
.ev-list{display:flex;flex-direction:column;gap:2px}
.ev-row{display:flex;align-items:center;justify-content:space-between;gap:8px;width:100%;margin:0;padding:3px 6px;border:0;border-radius:4px;background:transparent;font:inherit;font-size:11px;color:inherit;text-align:left;cursor:pointer;transition:background .1s}
.ev-row:hover:not(.ev-row--off){background:var(--line2)}
.ev-row[aria-pressed="true"]{background:var(--accent-soft);box-shadow:inset 0 0 0 1px var(--accent)}
.ev-row.ev-row--off{opacity:.45;cursor:default}
.ev-row .ev-lbl{flex:1;min-width:0}
.ev-row.ev-row--primary .ev-lbl{font-weight:600;color:var(--ink)}
.ev-row .ev-val{font-variant-numeric:tabular-nums;color:var(--ink2);font-weight:600}
.ev-panels{margin-top:14px}
.ev-panels[hidden]{display:none!important}
.ev-panel{margin-top:0}
.ev-panel[hidden]{display:none!important}
.ev-panel-h{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px 12px;margin-bottom:8px}
.ev-panel-title{font-size:13px;font-weight:700;color:var(--ink)}
.ev-panel-count{font-size:11px;color:var(--ink3);font-variant-numeric:tabular-nums}
.ev-panel-close{padding:4px 10px;border-radius:99px;border:1px dashed var(--line);background:transparent;cursor:pointer;color:var(--ink3);font:inherit;font-size:11px}
.ev-panel-close:hover{color:var(--ink);border-color:var(--ink3)}
.ev-panel-note{margin:0 0 10px;font-size:11px}
.ev-panel .tw-scroll{max-height:min(360px,48vh);overflow:auto;-webkit-overflow-scrolling:touch}
.ev-panel .tw{min-width:0}
.ev-panel table{table-layout:fixed;width:100%}
.ev-picks{list-style:none;margin:0 0 12px;padding:0;display:flex;flex-direction:column;gap:6px}
.rl-rel.has-bin-filter .rl-svg .pl{opacity:.08}
.rl-rel.has-bin-filter .rl-svg .nd{opacity:.1}
.rl-rel.has-bin-filter .rl-svg .pl.bin-on{opacity:.88}
.rl-rel.has-bin-filter .rl-svg .pl.bin-on.hl{opacity:1;stroke-width:2.2}
.rl-rel.has-bin-filter .rl-svg .nd.bin-on{opacity:1}
/* Cluster/bin filter + list pick: keep y-axis, highlight one line in pick-hi */
.rl-rel.has-pick-highlight .rl-svg .pl.bin-on:not(.pick-on){opacity:.22!important;stroke-width:1.4!important}
.rl-rel.has-pick-highlight .rl-svg .nd.bin-on:not(.pick-on){opacity:.28!important}
.rl-rel.has-pick-highlight .rl-svg .pl.pick-on{opacity:1!important;stroke:var(--pick-hi)!important;stroke-width:3!important}
.rl-rel.has-pick-highlight .rl-svg .nd.pick-on{opacity:1!important;stroke:var(--pick-hi)!important;stroke-width:2.4!important;fill:#fff!important}
.rl-rel.has-pick-highlight .rl-svg .nd.pick-on:hover{r:5.4}
.chart-pick.chart-pick--on.pick-hi{background:rgba(217,26,114,.1);box-shadow:inset 0 0 0 1px var(--pick-hi)}

/* Insight cards (cross-window) */
.in-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:12px;margin-top:6px;min-width:0}
.in{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px;display:flex;flex-direction:column;min-width:0;max-width:100%}
.in-h{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:10px;min-width:0}
.in-h .t{font-weight:700;font-size:14px;min-width:0}
.in-h .c{font-size:11px;color:var(--ink3);font-variant-numeric:tabular-nums}
/* Insight full list: radios at .in-dash top; panels render below .in-grid (same cw-card) */
.in-dash{position:relative}
.idash-sr{position:absolute;opacity:0;width:1px;height:1px;margin:0;padding:0;clip:rect(0 0 0 0);border:0;appearance:none;pointer-events:none}
.in-full-toggle{cursor:pointer;font-size:11px;color:var(--accent);font-variant-numeric:tabular-nums;text-decoration:underline;text-underline-offset:2px;flex-shrink:0;white-space:nowrap;border:0;background:transparent;font:inherit;padding:0}
.in-full-toggle:hover{color:var(--ink)}
.idash-panel{display:none;margin-top:16px;padding-top:14px;border-top:1px solid var(--line);clear:both}
.idash-panel-h{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px 12px;margin-bottom:8px}
.idash-panel-title{font-size:13px;font-weight:700;color:var(--ink)}
.idash-panel-count{font-size:11px;color:var(--ink3);font-variant-numeric:tabular-nums}
.idash-close{cursor:pointer;font-size:11px;color:var(--accent);text-decoration:underline;text-underline-offset:2px;flex-shrink:0}
.idash-close:hover{color:var(--ink)}
.idash-panel .tw-scroll{max-height:min(360px,48vh);overflow:auto;-webkit-overflow-scrolling:touch}
.idash-panel .tw{min-width:0}
.idash-panel table{table-layout:fixed;width:100%}
.in-s{font-size:11px;color:var(--ink3);margin-bottom:10px}
.in ul{list-style:none;display:flex;flex-direction:column;gap:8px}
.in-row{display:grid;grid-template-columns:44px 1fr;gap:10px;align-items:center;font-size:12px}
.in-row .thumb-wrap{width:44px;height:44px;border-radius:6px;overflow:hidden;background:var(--line2);position:relative;display:flex;align-items:center;justify-content:center;color:var(--ink3);font-size:13px;font-weight:700;flex-shrink:0}
.in-row .thumb-wrap img{width:100%;height:100%;object-fit:cover;display:block}
.in-row .name{display:flex;flex-direction:column;gap:2px;min-width:0}
.in-row .name .b{font-weight:600;color:var(--ink);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.in-row .name .p{color:var(--ink2);font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.in-row .name .chain{display:flex;flex-wrap:wrap;gap:4px;margin-top:3px}
.in-row .name .chain .seg{font-size:10px;padding:1px 6px;border-radius:99px;background:var(--line2);color:var(--ink2);font-variant-numeric:tabular-nums}
.in-row .name .chain .seg.miss{color:var(--ink3);background:transparent;border:1px dashed var(--line)}
.in-row .name .meta{font-size:10.5px;color:var(--ink3);margin-top:2px;font-variant-numeric:tabular-nums}
.in-row .name .meta b.pos{color:var(--ok)}
.in-row .name .meta b.neg{color:var(--warn)}
.in-empty{font-size:12px;color:var(--ink3);padding:6px 0}

/* Momentum extrema + full insight tables */
.me-grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:12px}
.me-col{background:var(--line2);border-radius:12px;padding:12px 14px;border:1px solid var(--line)}
.me-col h4{font-size:12px;font-weight:700;color:var(--ink);margin-bottom:4px}
.me-col .me-sub{font-size:11px;color:var(--ink3);margin-bottom:8px;line-height:1.45}
.if-mom .pos{color:var(--ok)}
.if-mom .neg{color:var(--warn)}
.in-ft-chain{display:flex;flex-wrap:wrap;gap:4px;max-width:100%;min-width:0}
.in-ft-chain .seg{font-size:9.5px;padding:1px 5px;border-radius:99px;background:var(--line2);color:var(--ink2);font-variant-numeric:tabular-nums}
.in-ft-chain .seg.miss{color:var(--ink3);background:transparent;border:1px dashed var(--line)}
.tw .if-td-thumb{width:44px;padding-left:10px;padding-right:6px}
.tw .if-td-thumb .thumb{width:36px;height:36px;font-size:11px}
.tw .if-td-name{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tw .if-td-chain{min-width:0;max-width:100%}
.me-col .tw-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
.me-col .tw{min-width:0}
.me-col table{table-layout:fixed;width:100%}

/* Period TOP10 tables with thumbnails */
.pt-grid{display:grid;grid-template-columns:1fr;gap:14px}
.pt-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px;overflow:visible}
.pt-card h3{font-size:13px;font-weight:600;color:var(--ink2);margin-bottom:8px;display:flex;align-items:baseline;justify-content:space-between}
.pt-card h3 .sub{font-size:11px;color:var(--ink3);font-weight:400}
.pt-table{width:100%;border-collapse:collapse;font-size:12px}
.pt-table th{font-size:10px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink3);padding:6px 4px;text-align:left;font-weight:600;border-bottom:1px solid var(--line)}
.pt-table th.num{text-align:right}
.pt-table td{padding:6px 4px;border-bottom:1px solid var(--line2);vertical-align:middle}
.pt-table tr:last-child td{border-bottom:none}
.pt-table td.num{text-align:right;font-variant-numeric:tabular-nums}
.pt-table td.rk{font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums;width:28px}
.pt-table td.brand{font-weight:600;color:var(--ink);max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pt-table td.dim{color:var(--ink3)}
.bc-pane-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-bottom:14px}
@media(max-width:900px){.bc-pane-grid{grid-template-columns:1fr}}
.bc-pane-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px;display:flex;flex-direction:column}
.bc-pane-card h3{font-size:13px;font-weight:700;color:var(--ink);margin:0 0 12px;display:flex;align-items:baseline;justify-content:space-between;gap:10px;letter-spacing:.01em}
.bc-pane-card h3 .sub{font-size:11px;color:var(--ink3);font-weight:500;white-space:nowrap}
.bc-pane-table{width:100%;border-collapse:separate;border-spacing:0;font-size:12.5px;table-layout:fixed}
.bc-pane-table col.col-rk{width:56px}
.bc-pane-table th{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3);padding:6px 10px;text-align:left;font-weight:600;border-bottom:1px solid var(--line)}
.bc-pane-table td{padding:7px 10px;border-bottom:1px solid var(--line2);vertical-align:middle;white-space:nowrap}
.bc-pane-table tbody tr:last-child td{border-bottom:none}
.bc-pane-table td.rk{font-weight:600;font-variant-numeric:tabular-nums;color:var(--ink2);font-size:12px}
.bc-pane-table td.brand{font-weight:500;color:var(--ink);overflow:hidden;text-overflow:ellipsis}
.bc-pane-table tr.bc-target td{background:var(--accent-soft)}
.bc-pane-table tr.bc-target td.rk{color:var(--accent);font-weight:700;box-shadow:inset 3px 0 0 var(--accent)}
.bc-pane-table tr.bc-target td.brand{color:var(--accent);font-weight:700}
.bc-pane-table tr.bc-ellipsis td{color:var(--ink3);text-align:center;letter-spacing:.34em;font-weight:600;padding:6px;background:transparent;border-bottom-style:dashed;border-bottom-color:var(--line2)}
.bc-pane-table tr.bc-missing td.rk{color:var(--ink3);font-weight:600;letter-spacing:0}
.bc-pane-table tr.bc-missing.bc-target td.rk{color:var(--accent);opacity:.85}
.bc-pane-table tr.bc-missing td.brand{color:var(--ink2)}
.bc-pane-foot{font-size:11px;color:var(--ink3);margin:10px 0 0;line-height:1.45}
.pt-table td.product{color:var(--ink2);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pt-table tr.sold td.product{text-decoration:line-through;color:var(--ink3)}
.pt-table td.thumb{width:48px}
.pt-foot{font-size:10px;color:var(--ink3);margin-top:6px;display:flex;justify-content:space-between;gap:6px}
.pt-foot em{font-style:normal}

/* Shared hotlinked thumbnail */
.thumb{width:48px;height:48px;border-radius:6px;overflow:hidden;background:var(--line2);position:relative;display:inline-flex;align-items:center;justify-content:center;color:var(--ink3);font-size:14px;font-weight:700;flex-shrink:0;transition:transform .15s,z-index 0s;will-change:transform}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb:hover{transform:scale(2.6);z-index:50;box-shadow:0 8px 22px rgba(15,15,16,.22)}
.thumb-wrap:hover{transform:scale(2.4);z-index:50;box-shadow:0 8px 20px rgba(15,15,16,.22);position:relative}

/* Pattern legend chips */
.pat-chip{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:600;padding:2px 8px;border-radius:99px;background:var(--accent-soft);color:var(--accent)}
.pat-chip.up{background:rgba(13,138,74,.12);color:var(--ok)}
.pat-chip.down{background:rgba(217,119,6,.14);color:var(--warn)}
.pat-chip.flat{background:var(--line2);color:var(--ink3)}

/* Category report switcher (primary menu under header) */
.cat-switch{
  display:flex;gap:0;overflow-x:auto;
  margin:0;padding:0 8px;
  border-top:1px solid rgba(85,70,255,.12);
  background:rgba(255,255,255,.45);
  backdrop-filter:blur(8px);
  scrollbar-width:none;
}
.cat-switch::-webkit-scrollbar{display:none}
.cat-switch a{
  min-width:156px;flex-shrink:0;
  padding:17px 22px 15px;
  text-decoration:none;color:var(--ink2);
  border-bottom:2px solid transparent;
  background:transparent;
  transition:color .15s,border-color .15s,background .15s;
}
.cat-switch a:hover{color:var(--ink);background:rgba(15,15,16,.02);text-decoration:none}
.cat-switch a.active{
  color:var(--ink);
  border-bottom-color:var(--ink);
  background:rgba(15,15,16,.02);
}
.cat-switch a.cat-switch__brand{
  margin-left:4px;
  border-left:1px solid var(--line);
  padding-left:24px;
}
.cat-switch a.cat-switch__brand.active{border-bottom-color:var(--accent);color:var(--accent)}
.cat-switch b{display:block;font-size:15px;font-weight:700;letter-spacing:-.02em;color:inherit}
.cat-switch a.cat-switch__section{min-width:138px}
.cat-switch a.cat-switch__section.active{
  border-bottom-color:var(--accent);
  color:var(--accent);
  background:var(--accent-soft);
}

/* Brand portfolio tab */
.bp-note{font-size:12px;color:var(--ink2);line-height:1.65;margin-bottom:16px}
.bp-target-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:20px}
.bp-target-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.bp-target-card.is-target{border-color:rgba(85,70,255,.35);box-shadow:0 0 0 1px rgba(85,70,255,.08)}
.bp-target-card h3{font-size:14px;font-weight:700;margin:0 0 10px;display:flex;align-items:center;gap:8px}
.bp-target-card .lane{font-size:11px;color:var(--ink3);font-weight:600}
.bp-rank-row{display:flex;justify-content:space-between;font-size:12px;padding:4px 0;border-bottom:1px solid var(--line2)}
.bp-rank-row:last-child{border-bottom:none}
.bp-cat-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}
.bp-cat-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.bp-cat-card.has-target{border-color:rgba(85,70,255,.22)}
.bp-cat-card h3{font-size:14px;font-weight:700;margin:0 0 8px}
.bp-cat-meta{font-size:11px;color:var(--ink3);margin-bottom:10px}
.bp-cat-meta b{color:var(--ink);font-weight:600}
.bp-mini-bar{display:flex;align-items:center;gap:8px;font-size:11px;margin-bottom:5px}
.bp-mini-bar .lbl{flex:0 0 72px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bp-mini-bar .tr{flex:1;height:8px;background:var(--line2);border-radius:4px;position:relative;overflow:hidden}
.bp-mini-bar .fl{position:absolute;left:0;top:0;bottom:0;background:var(--accent);border-radius:4px}
.bp-mini-bar .vl{width:48px;text-align:right;color:var(--ink2);font-variant-numeric:tabular-nums}
.bp-mini-bar.is-target .lbl{color:var(--accent)}
.bp-matrix-wrap{overflow-x:auto;margin-top:12px}
.bp-matrix{width:100%;border-collapse:collapse;font-size:12px;min-width:640px}
.bp-matrix th,.bp-matrix td{padding:10px 12px;border-bottom:1px solid var(--line2);text-align:center;vertical-align:middle}
.bp-matrix th{font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink3);font-weight:600;background:var(--line2)}
.bp-matrix th.row-h,.bp-matrix td.row-h{text-align:left;font-weight:600;color:var(--ink);vertical-align:middle}
.bp-matrix td.rank-col{font-weight:700;font-variant-numeric:tabular-nums}
.bp-matrix td.rank-col.on{background:rgba(85,70,255,.08);color:var(--accent)}
.bp-matrix td.rank-col.off{color:var(--ink3);font-weight:500}
.bp-matrix td.bp-matrix-cell{text-align:left;vertical-align:top;min-width:120px}
.bp-matrix td.bp-matrix-cell.on{background:rgba(85,70,255,.04)}
.bp-matrix td.bp-matrix-cell.off{color:var(--ink3)}
.bp-cell-share{display:flex;align-items:baseline;gap:6px;margin-bottom:6px;font-size:13px;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
.bp-cell-count{font-size:10px;font-weight:600;color:var(--ink3)}
.bp-cell-products{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
.bp-dist-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:12px}
.bp-dist-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 16px 12px;display:flex;flex-direction:column;min-height:0}
.bp-dist-card h3{font-size:14px;font-weight:700;margin:0 0 4px}
.bp-dist-meta{font-size:11px;color:var(--ink3);margin:0 0 10px}
.bp-dist-meta b{color:var(--ink);font-weight:600}
.bp-dist-scroll{overflow:auto;max-height:420px;border:1px solid var(--line2);border-radius:10px}
.bp-dist-table{width:100%;border-collapse:collapse;font-size:12px}
.bp-dist-table th,.bp-dist-table td{padding:7px 10px;border-bottom:1px solid var(--line2);text-align:right;vertical-align:middle;font-variant-numeric:tabular-nums}
.bp-dist-table th{font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink3);font-weight:600;background:var(--line2);position:sticky;top:0;z-index:1}
.bp-dist-table th.col-brand,.bp-dist-table td.col-brand{text-align:left;font-weight:600;max-width:140px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bp-dist-table th.col-ord,.bp-dist-table td.col-ord{text-align:center;width:36px;color:var(--ink3);font-weight:500}
.bp-dist-table tr.is-target td.col-brand{color:var(--accent)}
.bp-dist-table tr.is-target{background:rgba(85,70,255,.05)}
.bp-dist-table tbody tr:last-child td{border-bottom:none}
.bp-dist-overall{margin-bottom:18px}
.bp-dist-overall .bp-dist-card{border-color:rgba(85,70,255,.18)}
.bp-dist-badge{font-size:10px;font-weight:600;color:var(--accent);background:var(--accent-soft);padding:2px 8px;border-radius:999px;margin-left:6px;vertical-align:middle}
.bp-dist-scroll--compact{max-height:none}
.bp-dist-brand-row{cursor:pointer;transition:background .12s ease}
.bp-dist-brand-row:hover td{background:rgba(85,70,255,.04)}
.bp-dist-brand-row.is-open td{background:rgba(85,70,255,.07)}
.bp-dist-brand-row .col-brand::after{content:'▾';margin-left:6px;font-size:9px;color:var(--ink3);opacity:.6}
.bp-dist-brand-row.is-open .col-brand::after{transform:rotate(180deg);display:inline-block}
.bp-dist-detail td{padding:0 10px 10px!important;border-bottom:1px solid var(--line2);background:rgba(85,70,255,.03)}
.bp-dist-detail[hidden]{display:none}
.bp-dist-products{list-style:none;margin:0;padding:8px 10px 4px;display:flex;flex-direction:column;gap:5px}
.bp-dist-products li{display:flex;align-items:baseline;gap:8px;font-size:11px;line-height:1.4}
.bp-dist-products .rk{flex:0 0 auto;font-size:10px;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
.bp-dist-products .cat{flex:0 0 auto;font-size:10px;color:var(--ink3);font-weight:600}
.bp-dist-products .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink2)}
.bp-dist-products a{color:inherit;text-decoration:none}
.bp-dist-products a:hover{color:var(--accent);text-decoration:underline}
.bp-dist-preview td.cat-chip{font-size:10px;color:var(--ink3);font-weight:600;white-space:nowrap}
.bp-dist-preview .brand{font-weight:600;color:var(--ink);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px}
.bp-dist-preview .product{color:var(--ink2);font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:280px}
.bp-dist-detail--rich td{padding:6px 8px 10px!important}
.bp-cell-products li{display:flex;align-items:baseline;gap:6px;font-size:11px;line-height:1.4}
.bp-cell-products .rk{flex:0 0 auto;font-size:10px;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
.bp-cell-products .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink2)}
.bp-cell-products a{color:inherit;text-decoration:none}
.bp-cell-products a:hover{color:var(--accent);text-decoration:underline}
.bp-cell-empty{color:var(--ink3)}
.bp-link-card{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 18px;background:var(--accent-soft);border:1px solid rgba(85,70,255,.2);border-radius:12px;margin:14px 0;text-decoration:none;color:var(--ink)}
.bp-link-card:hover{text-decoration:none;border-color:var(--accent)}
.bp-link-card b{font-size:13px}
.bp-link-card span{font-size:12px;color:var(--ink2)}

/* Legacy fold-out for cross_window comparison tables */
details.cw-legacy{margin-top:14px}
details.cw-legacy summary{cursor:pointer;font-size:11px;color:var(--ink3);font-weight:600;padding:6px 10px;background:transparent;border:1px dashed var(--line);border-radius:8px;list-style:none;display:inline-block}
details.cw-legacy summary::-webkit-details-marker{display:none}

@media(max-width:720px){
  .shell{padding:24px 16px 56px}
  .app-top{border-radius:18px;margin-bottom:22px}
  .hd-hero{padding:22px 18px 20px}
  .app-top__context{margin-top:14px;padding:10px 12px}
  .hd-hero__inner{flex-direction:column;align-items:stretch;gap:18px}
  .hd-hero__stats{grid-template-columns:repeat(2, 1fr);width:100%}
  .cat-switch a{min-width:132px;padding:15px 16px 13px}
  .cat-switch b{font-size:14px}
  .kpi{grid-template-columns:repeat(2,1fr)}
  .report-nav{padding-left:16px;padding-right:16px;scroll-padding-inline:16px}
  .report-nav-wrap::before,.report-nav-wrap::after{width:20px}
  .cw-grid-2{grid-template-columns:1fr}
  .bp-dist-grid{grid-template-columns:1fr}
}
{% if analysis.cross_window.has_data %}
{% for card in analysis.cross_window.insights %}
{% if card.rows %}
#idash-{{ card.key }}:checked ~ #idash-panel-{{ card.key }}{display:block}
{% endif %}
{% endfor %}
{% endif %}
</style>
</head>
<body>
{% set is_brand_report = analysis.meta.report_kind == 'brand_portfolio' %}
{% set is_customer_signals_report = analysis.meta.report_kind == 'customer_signals' %}
{% set bp = analysis.brand_portfolio if is_brand_report else {} %}
{% set hm_panels = analysis.price_age_heatmap_panels if analysis.price_age_heatmap_panels is defined else none %}
<div class="shell">

<div class="app-top">
  <div class="app-top__frame">
<header class="hd-hero">
  <div class="hd-hero__glow" aria-hidden="true"></div>
  <div class="hd-hero__inner">
    <div class="hd-hero__main">
      <p class="hd-hero__eyebrow"><span class="hd-hero__mark" aria-hidden="true"></span>Silhouette Ranking Outliner</p>
      <h1 class="hd-hero__title">패션 동향 분석 보고서</h1>
      <div class="app-top__context">
        <span class="app-top__context-icon" aria-hidden="true">⌕</span>
        <div class="app-top__context-body">
          <p class="hd-hero__lead">
            {{ analysis.headline.collected_at_kst_pretty }} 기준
            {% if analysis.headline.primary_window_label %}
            · {{ analysis.headline.primary_window_label }}
            {% endif %}
            · TOP {{ analysis.headline.limit_target or analysis.headline.item_count }}
            · 수집 {{ analysis.headline.item_count }}건
            {% if analysis.headline.total_item_count is defined and analysis.headline.total_item_count != analysis.headline.item_count %}
            · 기간별 스냅샷 {{ analysis.headline.total_item_count }}행
            {% endif %}
          </p>
          <div class="hd-hero__chips">
            {% if is_brand_report %}
            <span class="hd-hero__chip hd-hero__chip--accent">브랜드 포트폴리오</span>
            {% elif analysis.headline.category and analysis.headline.category != '데이터 없음' %}
            <span class="hd-hero__chip hd-hero__chip--accent">{{ analysis.headline.category }}</span>
            {% endif %}
            {% if analysis.meta.multiple_windows and analysis.headline.primary_window_label %}
            <span class="hd-hero__chip">기본 패널 {{ analysis.headline.primary_window_label }}</span>
            {% elif is_brand_report and bp.primary_window_label %}
            <span class="hd-hero__chip">기본 패널 {{ bp.primary_window_label }}</span>
            {% endif %}
            {% if analysis.meta.multiple_categories and not is_brand_report %}
            <span class="hd-hero__chip">다중 카테고리</span>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    <aside class="hd-hero__stats" aria-label="스냅샷 요약">
      {% if is_brand_report %}
      <div class="hd-stat">
        <div class="hd-stat__lbl">카테고리</div>
        <div class="hd-stat__val">{{ bp.category_count }}<small>종</small></div>
      </div>
      <div class="hd-stat">
        <div class="hd-stat__lbl">타겟</div>
        <div class="hd-stat__val">{{ bp.target_count }}<small>개</small></div>
      </div>
      {% else %}
      <div class="hd-stat">
        <div class="hd-stat__lbl">수집 범위</div>
        <div class="hd-stat__val">TOP {{ analysis.headline.limit_target or analysis.headline.item_count }}</div>
      </div>
      <div class="hd-stat">
        <div class="hd-stat__lbl">수집 건수</div>
        <div class="hd-stat__val">{{ analysis.headline.item_count }}<small>건</small></div>
      </div>
      <div class="hd-stat">
        <div class="hd-stat__lbl">브랜드</div>
        <div class="hd-stat__val">{{ analysis.kpis.brand_count }}<small>개</small></div>
      </div>
      <div class="hd-stat">
        <div class="hd-stat__lbl">중앙 가격</div>
        <div class="hd-stat__val">{% if analysis.kpis.median_price is not none %}{{ analysis.kpis.median_price|currency }}<small>원</small>{% else %}–{% endif %}</div>
      </div>
      {% endif %}
    </aside>
  </div>
</header>

{% if analysis.category_nav %}
<nav class="cat-switch app-top__menu" aria-label="카테고리 보고서">
  {% for nav in analysis.category_nav %}
  <a href="{{ nav.href }}"
     class="
       {%- if nav.active %}active{% endif -%}
       {%- if nav.kind == 'customer_signals' %} cat-switch__section{% endif -%}
       {%- if nav.kind == 'brand_portfolio' %} cat-switch__brand{% endif -%}
     ">
    <b>{{ nav.label }}</b>
  </a>
  {% endfor %}
</nav>
{% endif %}
  </div>
</div>

<div class="report-nav-wrap">
<nav class="report-nav" aria-label="본문 바로가기">
{% if is_brand_report %}
  <a href="#sec-bp-summary">포트폴리오 요약</a>
  <a href="#sec-bp-categories">카테고리 점유</a>
  <a href="#sec-bp-brand-dist">브랜드별 상품 랭킹 점유율</a>
  <a href="#sec-bp-matrix">타겟 현황</a>
  {% if bp.bcave.has_data %}<a href="#sec-bp-rankings">브랜드 랭킹</a>{% endif %}
{% elif is_customer_signals_report %}
  <a href="#sec-customer-signals">고객 신호</a>
  {% if analysis.price_age_heatmap_panels is defined and analysis.price_age_heatmap_panels.has_data %}<a href="#sec-heatmap">가격 × 나이</a>{% endif %}
  {% if analysis.age_rankings is defined and analysis.age_rankings.has_data %}<a href="#sec-age-rankings">연령별 실시간</a>{% endif %}
  {% if analysis.customer_signals is defined and analysis.customer_signals.has_data %}<a href="#sec-cs-content">콘텐츠판</a><a href="#sec-cs-keywords">검색어</a>{% endif %}
{% else %}
  <a href="#sec-kpi">한눈에</a>
  {% if analysis.cross_window.has_data %}<a href="#sec-cross">기간 교차 · 모멘텀</a>{% endif %}
  {% if analysis.cross_window.has_data and analysis.cross_window.momentum_extrema.has_data %}<a href="#sec-cross-lists">모멘텀 순위표</a>{% endif %}
  {% if analysis.meta.multiple_windows %}<a href="#sec-period-kpi">기간별 TOP 10</a>{% endif %}
  {% if analysis.scatter.has_data %}<a href="#sec-dashboard">결과 대시보드</a>{% endif %}
  <a href="#sec-outliers">주목할 다섯</a>
  {% if analysis.price_dot_strip.has_data %}<a href="#sec-price">가격 분포</a>{% endif %}
  <a href="#sec-full-list">전체 TOP 100</a>
{% endif %}
</nav>
</div>


{% if is_brand_report and bp.has_data %}
<section id="sec-bp-summary">
  <div class="sec-h"><h2>포트폴리오 요약</h2><p>BCave 타겟 브랜드의 브랜드 탭 순위 (전체/전체 · 스타일 레인)</p></div>
  <p class="bp-note">{{ bp.disclaimer }}</p>
  {% set bt = bp.bcave %}
  <div class="bp-target-grid">
  {% for row in bt.brands %}
    <div class="bp-target-card is-target">
      <h3>{{ row.label_ko }} <span class="lane">{{ row.style_lane_label }}</span></h3>
      <div class="bp-rank-row"><span>전체/전체</span><b>{{ row.overall.rank_label }}</b></div>
      <div class="bp-rank-row"><span>{{ row.style_lane_label }}</span><b>{{ row.style_lane.rank_label }}</b></div>
    </div>
  {% endfor %}
  </div>
</section>

<section id="sec-bp-categories">
  <div class="sec-h"><h2>카테고리 점유</h2><p>수집 카테고리별 상품 TOP 100 안 브랜드 SKU 비율 · 기본 패널 {{ bp.primary_window_label }}</p></div>
  <div class="bp-cat-grid">
  {% for cat in bp.category_share_rows %}
    <div class="bp-cat-card{% if cat.has_targets %} has-target{% endif %}">
      <h3>{{ cat.category_label }}</h3>
      <p class="bp-cat-meta">상품 <b>{{ cat.item_count }}</b> · 브랜드 <b>{{ cat.brand_count }}</b> · HHI <b>{{ cat.hhi|int }}</b> ({{ cat.hhi_level_label }})</p>
      {% for bar in cat.top_brands[:4] %}
      <div class="bp-mini-bar{% if bar.is_target %} is-target{% endif %}">
        <span class="lbl">{% if bar.is_target %}{{ bar.target_label }}{% else %}{{ bar.brand }}{% endif %}</span>
        <div class="tr"><div class="fl" style="width:{{ bar.bar_scale_pct }}%"></div></div>
        <span class="vl">{{ bar.share_pct }}%</span>
      </div>
      {% endfor %}
    </div>
  {% endfor %}
  </div>
</section>

{% macro bp_brand_dist_product_preview(products) %}
<table class="pt-table bp-dist-preview">
  <thead><tr><th class="num">#</th><th>이미지</th><th>브랜드 · 상품</th><th class="num">가격</th><th class="num">검증</th></tr></thead>
  <tbody>
  {% for p in products %}
    <tr{% if p.is_sold_out %} class="sold"{% endif %}>
      <td class="rk">{{ p.rank }}</td>
      <td class="thumb">
        {% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ thumb(p.image_url, p.brand, p.product) }}</a>{% else %}{{ thumb(p.image_url, p.brand, p.product) }}{% endif %}
      </td>
      <td>
        <div class="brand">{{ p.brand }}{% if p.category_label %} <span class="cat-chip">{{ p.category_label }}</span>{% endif %}</div>
        <div class="product">{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.product }}</a>{% else %}{{ p.product }}{% endif %}</div>
      </td>
      <td class="num">{% if p.price is not none %}{{ p.price|currency }}원{% else %}–{% endif %}{% if p.discount_rate and p.discount_rate > 0 %} <em style="color:var(--warn);font-style:normal">-{{ p.discount_rate|percent }}</em>{% endif %}</td>
      <td class="num">{{ "%.2f"|format(p.validation) }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endmacro %}

{% macro bp_brand_dist_table(tbl, detailed_preview=false) %}
<div class="bp-dist-card{% if tbl.is_overall %} bp-dist-card--overall{% endif %}">
  <h3>{{ tbl.category_label }}{% if tbl.is_overall %} <span class="bp-dist-badge">TOP {{ tbl.top_n }}</span>{% endif %}</h3>
  <p class="bp-dist-meta">상품 <b>{{ tbl.item_count }}</b> · 브랜드 <b>{{ tbl.brand_count }}</b>{% if tbl.is_overall %} · 수집 카테고리 합산{% endif %}</p>
  <div class="bp-dist-scroll{% if tbl.is_overall %} bp-dist-scroll--compact{% endif %}">
    <table class="bp-dist-table" data-scope="{{ tbl.category_code }}">
      <thead>
        <tr>
          <th class="col-ord">#</th>
          <th class="col-brand">브랜드</th>
          <th>상품 수</th>
          <th>비율</th>
          <th>최고 순위</th>
        </tr>
      </thead>
      <tbody>
      {% for row in tbl.rows %}
        <tr class="bp-dist-brand-row{% if row.is_target %} is-target{% endif %}" data-row-key="{{ row.row_key }}" role="button" tabindex="0" aria-expanded="false">
          <td class="col-ord">{{ row.display_order }}</td>
          <td class="col-brand" title="{{ row.brand }}">{% if row.is_target %}{{ row.target_label }}{% else %}{{ row.brand }}{% endif %}</td>
          <td>{{ row.product_count }}</td>
          <td>{{ row.share_pct }}%</td>
          <td>{{ row.best_rank_label }}</td>
        </tr>
        <tr class="bp-dist-detail{% if detailed_preview %} bp-dist-detail--rich{% endif %}" data-row-key="{{ row.row_key }}" hidden>
          <td colspan="5">
            {% if row.top_products %}
              {% if detailed_preview %}
                {{ bp_brand_dist_product_preview(row.top_products) }}
              {% else %}
            <ul class="bp-dist-products">
              {% for p in row.top_products %}
              <li>
                <span class="rk">{{ p.rank_label }}</span>
                {% if p.category_label %}<span class="cat">{{ p.category_label }}</span>{% endif %}
                <span class="nm" title="{{ p.product }}">{% if p.url %}<a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.product }}</a>{% else %}{{ p.product }}{% endif %}</span>
              </li>
              {% endfor %}
            </ul>
              {% endif %}
            {% else %}
            <p class="bp-dist-meta" style="margin:8px 10px">표시할 상품이 없습니다.</p>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endmacro %}

<section id="sec-bp-brand-dist">
  <div class="sec-h"><h2>브랜드별 상품 랭킹 점유율</h2><p>카테고리별 TOP 100 상품 랭킹에 올라온 브랜드별 SKU 수 · 상품 수 내림차순 · 기본 패널 {{ bp.primary_window_label }} · 브랜드 행을 누르면 상위 3개 SKU</p></div>
  {% if bp.overall_brand_table %}
  <div class="bp-dist-overall">
    {{ bp_brand_dist_table(bp.overall_brand_table, true) }}
  </div>
  {% endif %}
  <div class="bp-dist-grid">
  {% for tbl in bp.category_brand_tables %}
    {{ bp_brand_dist_table(tbl) }}
  {% endfor %}
  </div>
</section>

<section id="sec-bp-matrix">
