  {% set heatmap_cats = hm_panels.categories %}
  {% if heatmap_cats|length > 1 %}
  <div class="heat-toolbar cs-heatmap-cat-toolbar">
    <span class="lbl">카테고리</span>
    <div class="heat-gender cs-heatmap-cat-tabs" role="group" aria-label="히트맵 카테고리 전환">
      {% for panel in heatmap_cats %}
      <button type="button" class="heat-gender-btn cs-heatmap-cat-btn" data-cs-cat="{{ panel.code }}"
        aria-pressed="{{ 'true' if panel.code == hm_panels.default_code else 'false' }}"
        {% if not panel.has_data %} disabled title="수집 데이터 없음"{% endif %}>{{ panel.label }}</button>
      {% endfor %}
    </div>
  </div>
  {% endif %}
  <div class="cs-heatmap-panels">
  {% for panel in heatmap_cats %}
    {% set hm = panel.heatmap %}
    <div class="cs-heatmap-panel{% if panel.code == hm_panels.default_code %} is-active{% endif %}"
         data-cs-cat="{{ panel.code }}"
         {% if panel.code != hm_panels.default_code %}hidden{% endif %}>
      {% if hm.has_data %}
      {% set active = hm.active %}
      <section class="heat-wrap heat-gender-{{ hm.default_gender }}"
               data-default-gender="{{ hm.default_gender }}"
               data-active-gender="{{ hm.default_gender }}"
               data-bar-mode="single"
               data-heat-view="grid"
               data-cs-cat-code="{{ panel.code }}">
        <div class="heat">
          <div class="heat-toolbar">
            {% set hm_window_label = hm.ranking_window_label or analysis.meta.demographics_window_label %}
            {% if hm_window_label %}
            <span class="heat-window-chip" title="config의 demographics_window와 동일">랭킹 기간 <strong>{{ hm_window_label }}</strong></span>
            {% endif %}
            <span class="heat-window-chip cs-heatmap-cat-chip">카테고리 <strong>{{ panel.label }}</strong></span>
            <span class="lbl">성별</span>
            <div class="heat-gender" role="group" aria-label="성별 필터">
