    <span>{{ analysis.quality.sentence }}</span>
  </div>
  <div class="right">{{ analysis.headline.collected_at_utc }} · generated {{ analysis.generated_at }}</div>
</footer>

</div>

<script>
(function(){
  function openFullListIfHash(){
    if (location.hash !== '#sec-full-list') return;
    var d = document.getElementById('sec-full-list');
    if (d && d.tagName === 'DETAILS') d.open = true;
  }
  openFullListIfHash();
  window.addEventListener('hashchange', openFullListIfHash);
})();
(function(){
  var root = document.getElementById('sec-bp-brand-dist');
  if (!root) return;
  function closeAll(){
    root.querySelectorAll('.bp-dist-detail').forEach(function(d){ d.hidden = true; });
    root.querySelectorAll('.bp-dist-brand-row').forEach(function(r){
      r.classList.remove('is-open');
      r.setAttribute('aria-expanded', 'false');
    });
  }
  root.querySelectorAll('.bp-dist-brand-row').forEach(function(row){
    row.addEventListener('click', function(){
      var detail = row.nextElementSibling;
      if (!detail || !detail.classList.contains('bp-dist-detail')) return;
      var willOpen = detail.hidden;
      closeAll();
      if (willOpen) {
        detail.hidden = false;
        row.classList.add('is-open');
        row.setAttribute('aria-expanded', 'true');
      }
    });
    row.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        row.click();
      }
    });
  });
})();
(function(){
  function escapeHtml(s){
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
      return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];
    });
  }
  function norm(s){ return String(s || '').toLowerCase().trim(); }
  function matchQuery(el, q){
    if (!q) return true;
    var hay = norm(el.getAttribute('data-brand')) + ' ' + norm(el.getAttribute('data-product'));
    return hay.indexOf(q) >= 0;
  }
  function selKey(key){
    return String(key || '').replace(/\\/g, '\\\\').replace(/"/g, '\\"');
  }
  function niceTicks(minR, maxR){
    var ticks = [];
    var span = maxR - minR;
    var step = span <= 15 ? 5 : (span <= 40 ? 10 : 25);
    var start = Math.max(1, Math.floor(minR / step) * step);
    for (var r = start; r <= maxR; r += step) ticks.push(r);
    if (!ticks.length || ticks[0] > minR) ticks.unshift(Math.max(1, minR));
    if (ticks[ticks.length - 1] < maxR) ticks.push(maxR);
    return ticks.filter(function(v, i, a){ return i === 0 || v !== a[i-1]; });
  }

