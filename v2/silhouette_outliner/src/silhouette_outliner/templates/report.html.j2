      <h3>모멘텀 스팬 상·하위 {{ me.n }}개</h3>
      <p class="bc-note">momentum_span = rank_energy({{ me.to_label }}) − rank_energy({{ me.from_label }}). 스팬이 클수록 짧은 윈도우 쪽 순위 에너지가 더 큽니다.</p>
      <div class="me-grid">
        <div class="me-col">
          <h4>최상위 {{ me.n }}개</h4>
          <p class="me-sub">스팬 값이 가장 큰 상품 (양수 쪽 상단)</p>
          <div class="tw tw-scroll"><table>
            <thead><tr><th class="if-th-img" aria-label="이미지"></th><th>브랜드</th><th>상품</th><th>패턴</th><th class="num">스팬</th><th class="num">sust.</th><th>윈도우 순위</th></tr></thead>
            <tbody>{{ insight_table_rows(me.top) }}</tbody>
          </table></div>
        </div>
        <div class="me-col">
          <h4>최하위 {{ me.n }}개</h4>
          <p class="me-sub">스팬 값이 가장 작은 상품 (음수 쪽, 과거 누적이 더 강했던 경우)</p>
          <div class="tw tw-scroll"><table>
            <thead><tr><th class="if-th-img" aria-label="이미지"></th><th>브랜드</th><th>상품</th><th>패턴</th><th class="num">스팬</th><th class="num">sust.</th><th>윈도우 순위</th></tr></thead>
            <tbody>{{ insight_table_rows(me.bottom) }}</tbody>
          </table></div>
        </div>
      </div>
    </div>
    </div>
    {% endif %}

    {% if analysis.cross_window.legacy.pair_summaries or analysis.cross_window.legacy.momentum_span_rows %}
    <details class="cw-legacy">
      <summary>인접 윈도우 비교표 보기 (legacy)</summary>
      {% for pair in analysis.cross_window.legacy.pair_summaries %}
      <div class="cw-card" style="margin-top:12px">
        <h3 style="font-size:13px">{{ pair.from_label }} → {{ pair.to_label }}</h3>
        <p class="bc-note" style="margin-bottom:8px">{{ pair.from_label }}만 {{ pair.only_from_count }}건 · {{ pair.to_label }}만 {{ pair.only_to_count }}건 · 양쪽 모두 {{ pair.both_count }}건</p>
        {% if pair.top_delta_rows %}
        <div class="tw"><table>
          <thead><tr><th>브랜드</th><th>상품</th><th>#{{ pair.from_window }}</th><th>#{{ pair.to_window }}</th><th>순위차</th></tr></thead>
          <tbody>
          {% for row in pair.top_delta_rows %}
            <tr>
              <td>{{ row.brand }}</td>
              <td>{% if row.url %}<a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.product }}</a>{% else %}{{ row.product }}{% endif %}</td>
              <td class="num">{{ row.rank_a }}</td>
              <td class="num">{{ row.rank_b }}</td>
              <td class="num">{{ "%+d"|format(row.delta) }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
        {% endif %}
      </div>
      {% endfor %}
      {% if analysis.cross_window.legacy.momentum_span_rows %}
      <div class="cw-card" style="margin-top:12px">
        <h3 style="font-size:13px">스팬: {{ analysis.cross_window.legacy.momentum_span_endpoints.from_label }} ↔ {{ analysis.cross_window.legacy.momentum_span_endpoints.to_label }} (순위 변화 상위)</h3>
        <div class="tw"><table>
          <thead><tr><th>브랜드</th><th>상품</th><th>시작</th><th>끝</th><th>순위차</th></tr></thead>
          <tbody>
          {% for row in analysis.cross_window.legacy.momentum_span_rows %}
            <tr>
              <td>{{ row.brand }}</td>
              <td>{% if row.url %}<a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.product }}</a>{% else %}{{ row.product }}{% endif %}</td>
              <td class="num">{{ row.rank_a }}</td>
              <td class="num">{{ row.rank_b }}</td>
              <td class="num">{{ "%+d"|format(row.delta) }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
      </div>
      {% endif %}
    </details>
    {% endif %}
  </div>
</section>
{% endif %}

{% if analysis.meta.multiple_windows %}
<section id="sec-period-kpi">
